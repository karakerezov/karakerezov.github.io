# Copy this file to `.env` for local testing, and add the same two values in the
# Cloudflare dashboard (Settings → Environment variables) for the live site.
# See "The contact form" in README.md for step-by-step instructions.

# Your free API key from resend.com. Starts with "re_".
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO=karakerezov@gmail.com

# The From address Resend sends as. Until you have verified your own domain in
# Resend, leave this as the shared testing address.
CONTACT_FROM=Portfolio Contact <onboarding@resend.dev>
