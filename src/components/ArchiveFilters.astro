---
import site from '../data/site.json';
import { categorySlug } from '../lib/content';

/**
 * The category chips above the archive grid.
 *
 * Each chip is a real link to a real page (`/archive/c/<category>`), so the
 * filter works with JavaScript switched off — that is why these are links and
 * not buttons. When JavaScript is available, theme.ts intercepts the click,
 * filters the grid in place, keeps the address bar in step and announces the
 * new result count through the live region below.
 */
interface Props {
  /** Slug of the active category, or "all". */
  active: string;
  /** Number of items currently shown. */
  count: number;
}

const { active, count } = Astro.props;

const chips = site.archive.categories.map((name) => {
  const slug = name === site.archive.allLabel ? 'all' : categorySlug(name);
  return {
    name,
    slug,
    href: slug === 'all' ? '/archive' : `/archive/c/${slug}`,
  };
});

const countLabel =
  count === 1 ? site.archive.countSingular : site.archive.countPlural.replace('{n}', String(count));
---

<section class="hk-filters" aria-labelledby="filters-legend">
  <h2 class="hk-sr-only" id="filters-legend">{site.archive.filterLegend}</h2>

  <div
    class="hk-filter-row"
    role="group"
    aria-labelledby="filters-legend"
    data-hk-filter-group
    data-hk-active={active}
  >
    {
      chips.map((chip) => (
        <a
          href={chip.href}
          class="hk-chip"
          data-hk-filter={chip.slug}
          aria-current={chip.slug === active ? 'true' : undefined}
        >
          {chip.name}
        </a>
      ))
    }
  </div>

  <p
    class="hk-filter-count hk-meta-text"
    role="status"
    aria-live="polite"
    data-hk-filter-count
    data-singular={site.archive.countSingular}
    data-plural={site.archive.countPlural}
  >
    {countLabel}
  </p>
</section>

<style>
  .hk-filters {
    padding-bottom: 56px;
  }

  .hk-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hk-chip {
    display: inline-flex;
    align-items: center;
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--hk-ink-2);
    background: var(--hk-pill-fill);
    border: 1px solid var(--hk-hairline-2);
    border-radius: var(--hk-r-pill);
    padding: 11px 18px;
    min-height: 44px;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .hk-chip:hover {
    color: var(--hk-accent-text);
    border-color: var(--hk-accent-line);
  }

  .hk-chip[aria-current='true'] {
    color: var(--hk-accent-text);
    background: var(--hk-accent-soft);
    border-color: var(--hk-accent-line);
  }

  .hk-filter-count {
    margin-top: 20px;
  }
</style>
