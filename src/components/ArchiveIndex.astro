---
import site from '../data/site.json';
import PageIntro from './PageIntro.astro';
import ArchiveFilters from './ArchiveFilters.astro';
import ArchiveCard from './ArchiveCard.astro';
import SectionTransition from './SectionTransition.astro';
import ContactCta from './ContactCta.astro';
import type { ArchiveItem } from '../lib/content';

/**
 * The archive listing. Shared by `/archive` and by each `/archive/c/<slug>`
 * page, so the server-rendered version of a filtered view is identical to the
 * one JavaScript produces.
 */
interface Props {
  items: ArchiveItem[];
  /** Slug of the active category, or "all". */
  active: string;
  /** Everything, so hidden cards still exist for the client-side filter. */
  allItems: ArchiveItem[];
}

const { items, active, allItems } = Astro.props;
const shownIds = new Set(items.map((item) => item.id));
---

<div class="hk-shell">
  <PageIntro heading={site.archive.heading} lead={site.archive.lead} bottom="72px" />

  <ArchiveFilters active={active} count={items.length} />

  <section class="hk-archive-section" aria-label={site.archive.heading}>
    <ul class="hk-archive-grid">
      {allItems.map((item) => <ArchiveCard item={item} hidden={!shownIds.has(item.id)} />)}
    </ul>
  </section>

  <SectionTransition
    heading={site.archive.transitionHeading}
    body={site.archive.transitionBody}
    cta={site.archive.transitionCta}
    href="/work"
  />

  <div class="hk-archive-cta">
    <ContactCta variant="rule" />
  </div>
</div>

<style>
  .hk-archive-section {
    padding-bottom: 128px;
  }

  .hk-archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--hk-gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hk-archive-cta {
    padding-top: 96px;
  }

  @media (max-width: 900px) {
    .hk-archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hk-archive-section {
      padding-bottom: 80px;
    }
  }

  @media (max-width: 600px) {
    .hk-archive-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
