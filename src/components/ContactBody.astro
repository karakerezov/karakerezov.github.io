---
import site from '../data/site.json';
import PageIntro from './PageIntro.astro';
import ContactCard from './ContactCard.astro';
import ContactForm from './ContactForm.astro';

/**
 * The contact page body. Shared by /contact and by the two pages the form
 * redirects to, so all three look the same apart from the panel on the right.
 */
interface Props {
  state?: 'form' | 'sent' | 'error' | 'unavailable';
  errorMessage?: string;
}

const { state = 'form', errorMessage } = Astro.props;
---

<div class="hk-shell">
  <PageIntro heading={site.contact.heading} lead={site.contact.lead} bottom="72px" />

  <section class="hk-contact-body" data-hk-reveal>
    <div class="hk-contact-side">
      <div class="hk-contact-copy">
        <h2 class="hk-h2">{site.contact.formHeading}</h2>
        <p class="hk-prose hk-contact-lead">{site.contact.formLead}</p>
      </div>
      <div class="hk-contact-cards">
        <ContactCard kind="email" detail />
        {site.linkedin && <ContactCard kind="linkedin" detail />}
        {site.behance && <ContactCard kind="behance" detail />}
      </div>
    </div>

    <ContactForm state={state} errorMessage={errorMessage} />
  </section>
</div>

<style>
  .hk-contact-body {
    padding-bottom: 128px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  .hk-contact-side {
    display: flex;
    flex-direction: column;
    gap: var(--hk-gap);
  }

  .hk-contact-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hk-contact-lead {
    max-width: 460px;
  }

  .hk-contact-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (max-width: 900px) {
    .hk-contact-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-bottom: 80px;
    }
  }
</style>
