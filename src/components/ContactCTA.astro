---
import { CONTACT_EMAIL, LINKEDIN_URL } from '../data/nav';

interface Props {
  layout: 'cards' | 'row-dual' | 'row-single' | 'banner';
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  showCopyright?: boolean;
}

const {
  layout,
  heading = 'Let’s connect.',
  body = 'Open to UX/UI, product design and AI experience design opportunities.',
  ctaLabel = 'Get in touch',
  ctaHref = '/contact/',
  showCopyright = false,
} = Astro.props;
---

{layout === 'cards' && (
  <div class="cta cta-cards">
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-cards-list">
      <a class="cta-card" href={`mailto:${CONTACT_EMAIL}`}>
        <span class="cta-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00909E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
        <span class="cta-card-text"><span class="cta-card-label">Email</span><span class="cta-card-value">{CONTACT_EMAIL}</span></span>
      </a>
      <a class="cta-card" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
        <span class="cta-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00909E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-3a2 2 0 0 1 4 0v3"></path></svg></span>
        <span class="cta-card-text"><span class="cta-card-label">LinkedIn</span><span class="cta-card-value">linkedin.com/in/hristo-karakerezov-8a688151</span></span>
      </a>
    </div>
  </div>
)}

{layout === 'row-dual' && (
  <>
    <div class="cta cta-row">
      <div class="cta-copy">
        <h2>{heading}</h2>
        <p>{body}</p>
      </div>
      <div class="cta-pills">
        <a class="cta-pill" href={`mailto:${CONTACT_EMAIL}`}>
          <span class="cta-icon cta-icon-sm"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00909E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
          <span class="cta-pill-label">Email</span>
        </a>
        <a class="cta-pill" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
          <span class="cta-icon cta-icon-sm"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00909E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-3a2 2 0 0 1 4 0v3"></path></svg></span>
          <span class="cta-pill-label">LinkedIn</span>
        </a>
      </div>
    </div>
    {showCopyright && <p class="cta-copyright">&copy; 2026 Hristo Karakerezov</p>}
  </>
)}

{layout === 'row-single' && (
  <div class="cta cta-row">
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <a class="cta-button" href={ctaHref} target={ctaHref.startsWith('http') ? '_blank' : undefined} rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}>
      {ctaLabel}<span aria-hidden="true">&rarr;</span>
    </a>
  </div>
)}

{layout === 'banner' && (
  <div class="cta cta-banner">
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <a class="cta-button" href={ctaHref} target={ctaHref.startsWith('http') ? '_blank' : undefined} rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}>
      {ctaLabel}<span aria-hidden="true">&#8599;</span>
    </a>
  </div>
)}

<style>
  .cta { display: flex; flex-direction: column; gap: 20px; }
  .cta h2 {
    font-family: var(--hk-font-display); font-weight: 400;
    font-size: clamp(40px, 4vw, 56px); line-height: 1.05; letter-spacing: -0.02em;
  }
  .cta p { font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); max-width: 520px; }

  .cta-row {
    flex-direction: row; align-items: center; justify-content: space-between; gap: 48px;
    flex-wrap: wrap; border-top: 1px solid var(--hk-hairline); padding-top: 72px;
  }
  .cta-pills { display: flex; gap: 20px; flex-wrap: wrap; }
  .cta-pill {
    display: flex; align-items: center; gap: 14px; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); border-radius: 32px; padding: 20px 26px;
    color: var(--hk-ink); transition: transform .3s ease, box-shadow .3s ease;
  }
  .cta-pill:hover { transform: translateY(-3px); box-shadow: 0 24px 44px -36px rgba(21,21,21,0.25); color: var(--hk-ink); }
  .cta-pill-label { font-size: 15px; font-weight: 700; line-height: 1; }
  .cta-icon { width: 44px; height: 44px; border-radius: 999px; background: var(--hk-accent-soft); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cta-icon-sm { width: 40px; height: 40px; }
  .cta-copyright { margin: 64px 8px 0; font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); text-align: center; }

  .cta-button {
    display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1;
    color: var(--hk-bg); background: var(--hk-ink); border: 1px solid var(--hk-ink); border-radius: var(--hk-r-pill);
    padding: 16px 28px; transition: background .25s ease, border-color .25s ease; flex-shrink: 0;
  }
  .cta-button:hover { background: var(--hk-accent); border-color: var(--hk-accent); color: var(--hk-bg); }

  .cta-banner {
    background: var(--hk-surface-alt); border-radius: var(--hk-r-card); padding: 80px 64px;
    flex-direction: row; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap;
  }

  .cta-cards { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: center; background: var(--hk-surface-alt); border-radius: var(--hk-r-card); padding: 80px 64px; }
  .cta-cards-list { display: flex; flex-direction: column; gap: 20px; }
  .cta-card {
    display: flex; align-items: center; gap: 16px; background: var(--hk-surface); border: 1px solid var(--hk-hairline);
    border-radius: var(--hk-r-media); padding: 24px 28px; color: var(--hk-ink);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .cta-card:hover { transform: translateY(-3px); box-shadow: 0 24px 44px -36px rgba(21,21,21,0.25); color: var(--hk-ink); }
  .cta-card-text { display: flex; flex-direction: column; gap: 4px; }
  .cta-card-label { font-size: 15px; font-weight: 700; line-height: 1; }
  .cta-card-value { font-size: 15px; line-height: 1.3; color: var(--hk-ink-2); }

  @media (max-width: 900px) {
    .cta-cards, .cta-banner, .cta-row { padding: 48px 32px; }
  }
  @media (max-width: 760px) {
    .cta-cards { grid-template-columns: 1fr; }
    .cta-row, .cta-banner, .cta-cards { flex-direction: column; align-items: flex-start; }
  }
</style>
