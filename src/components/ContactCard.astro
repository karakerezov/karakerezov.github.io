---
import site from '../data/site.json';

interface Props {
  kind: 'email' | 'linkedin' | 'behance';
  /** Show the address or profile name under the label. */
  detail?: boolean;
}

const { kind, detail = false } = Astro.props;

const cards = {
  email: {
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    external: false,
  },
  linkedin: {
    label: 'LinkedIn',
    value: site.linkedin.replace(/^https?:\/\/(www\.)?/, ''),
    href: site.linkedin,
    external: true,
  },
  behance: {
    label: 'Behance',
    value: site.behance.replace(/^https?:\/\/(www\.)?/, ''),
    href: site.behance,
    external: true,
  },
} as const;

const card = cards[kind];
---

<a
  href={card.href}
  class="hk-contact-card"
  class:list={[detail && 'is-detail']}
  rel={card.external ? 'me noopener' : undefined}
  target={card.external ? '_blank' : undefined}
>
  <span class="hk-contact-icon" aria-hidden="true">
    {
      kind === 'email' && (
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="3" />
          <path d="M3 7l9 6 9-6" />
        </svg>
      )
    }
    {
      kind === 'linkedin' && (
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="4" width="16" height="16" rx="4" />
          <path d="M8 11v5" />
          <path d="M8 8v.01" />
          <path d="M12 16v-3a2 2 0 0 1 4 0v3" />
        </svg>
      )
    }
    {
      kind === 'behance' && (
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M8 12h8" />
          <path d="M9 9c1.5 2 4.5 2 6 0" />
          <path d="M9 15c1.5-2 4.5-2 6 0" />
        </svg>
      )
    }
  </span>
  <span class="hk-contact-text">
    {
      detail ? (
        <span class="hk-contact-label">{card.label}</span>
      ) : (
        <span class="hk-contact-title">{card.label}</span>
      )
    }
    {detail && <span class="hk-contact-value">{card.value}</span>}
  </span>
</a>

<style>
  .hk-contact-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline);
    border-radius: var(--hk-r-media);
    padding: 20px 26px;
    color: var(--hk-ink);
    min-height: 44px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hk-contact-card.is-detail {
    gap: 16px;
    padding: 24px 28px;
  }

  .hk-contact-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--hk-tile-shadow);
    color: var(--hk-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-contact-card:hover {
      transform: none;
    }
  }

  .hk-contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--hk-r-pill);
    background: var(--hk-accent-soft);
    color: var(--hk-accent-text);
  }

  .is-detail .hk-contact-icon {
    width: 44px;
    height: 44px;
  }

  .hk-contact-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .hk-contact-title {
    font-size: var(--hk-meta);
    font-weight: 700;
    line-height: 1;
  }

  .hk-contact-label {
    font-size: var(--hk-meta);
    font-weight: 700;
    line-height: 1;
  }

  .hk-contact-value {
    font-size: var(--hk-meta);
    line-height: 1.3;
    color: var(--hk-ink-2);
    overflow-wrap: anywhere;
  }
</style>
