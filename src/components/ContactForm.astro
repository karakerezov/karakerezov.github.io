---
import site from '../data/site.json';

/**
 * The contact panel.
 *
 * The form is an ordinary HTML form that posts to the Cloudflare Pages
 * function at /api/contact. That function sends the message and then redirects
 * to /contact/thank-you or /contact/error, both of which are real pages. So the
 * whole thing works with JavaScript switched off, and the site ships no
 * JavaScript for it at all.
 */
interface Props {
  /** `unavailable` is shown when the mail service has not been set up yet. */
  state?: 'form' | 'sent' | 'error' | 'unavailable';
  /** Message shown in the error summary, when there is one. */
  errorMessage?: string;
}

const { state = 'form', errorMessage } = Astro.props;
const c = site.contact;
---

<div class="hk-form-panel hk-card">
  {
    state === 'unavailable' ? (
      <div class="hk-form-result">
        <span class="hk-form-icon is-warning" aria-hidden="true">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="M3 7l9 6 9-6" />
          </svg>
        </span>
        <h2 class="hk-form-result-heading" tabindex="-1" autofocus>
          {c.unavailableHeading}
        </h2>
        <p class="hk-prose">{c.unavailableBody}</p>
        <a href={`mailto:${site.email}`} class="hk-btn hk-btn-solid">
          {c.unavailableCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    ) : state === 'sent' ? (
      <div class="hk-form-result">
        <span class="hk-form-icon" aria-hidden="true">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
        </span>
        <h2 class="hk-form-result-heading" tabindex="-1" autofocus>
          {c.successHeading}
        </h2>
        <p class="hk-prose">{c.successBody}</p>
        <a href="/" class="hk-btn hk-btn-ghost">
          {site.notFound.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    ) : (
      <form class="hk-form" method="post" action="/api/contact">
        {state === 'error' && (
          <div class="hk-form-error" role="alert" tabindex="-1" autofocus>
            <p class="hk-form-error-heading">{c.errorSummaryHeading}</p>
            <p class="hk-form-error-body">{errorMessage || c.errorBody}</p>
          </div>
        )}

        <div class="hk-field">
          <label for="cf-name">{c.labelName}</label>
          <input
            id="cf-name"
            class="hk-input"
            type="text"
            name="name"
            placeholder={c.placeholderName}
            autocomplete="name"
            aria-describedby="cf-name-hint"
            required
          />
          <p class="hk-hint" id="cf-name-hint">
            {c.hintName}
          </p>
        </div>

        <div class="hk-field">
          <label for="cf-email">{c.labelEmail}</label>
          <input
            id="cf-email"
            class="hk-input"
            type="email"
            name="email"
            placeholder={c.placeholderEmail}
            autocomplete="email"
            aria-describedby="cf-email-hint"
            required
          />
          <p class="hk-hint" id="cf-email-hint">
            {c.hintEmail}
          </p>
        </div>

        <div class="hk-field">
          <label for="cf-message">{c.labelMessage}</label>
          <textarea
            id="cf-message"
            class="hk-input hk-textarea"
            name="message"
            placeholder={c.placeholderMessage}
            aria-describedby="cf-message-hint"
            required
          />
          <p class="hk-hint" id="cf-message-hint">
            {c.hintMessage}
          </p>
        </div>

        {/*
          A trap for automated spam. Real visitors never see or focus it;
          anything that fills it in is discarded by the function.
        */}
        <div class="hk-honeypot" aria-hidden="true">
          <label for="cf-company">Company</label>
          <input id="cf-company" type="text" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div class="hk-form-actions">
          <button type="submit" class="hk-btn hk-btn-solid">
            {c.submit}
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    )
  }

  <p class="hk-form-note">
    {c.directNote}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</div>

<style>
  .hk-form-panel {
    padding: 48px;
  }

  .hk-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hk-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hk-field label {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--hk-ink-2);
  }

  .hk-input {
    font-family: var(--hk-font-body);
    font-size: 16px;
    color: var(--hk-ink);
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline-2);
    border-radius: var(--hk-r-field);
    padding: 18px 22px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    width: 100%;
    min-height: 44px;
  }

  .hk-input::placeholder {
    color: var(--hk-ink-3-text);
  }

  /* The design's soft glow, plus the outline everything else on the site
     uses — the field is never left without a visible focus indicator. */
  .hk-input:focus {
    border-color: var(--hk-accent);
    box-shadow: 0 0 0 4px var(--hk-accent-soft);
  }

  .hk-input:focus-visible {
    outline: 2px solid var(--hk-accent);
    outline-offset: 2px;
  }

  /* The browser's own validation styling, once the field has been touched. */
  .hk-input:user-invalid {
    border-color: var(--hk-error);
  }

  .hk-textarea {
    min-height: 160px;
    resize: vertical;
    line-height: 1.55;
  }

  .hk-hint {
    font-size: var(--hk-meta-sm);
    line-height: 1.4;
    color: var(--hk-ink-3-text);
    padding-inline: 4px;
  }

  .hk-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .hk-form-actions {
    margin-top: 4px;
  }

  .hk-btn-solid {
    padding: 16px 28px;
  }

  /* --- Error summary -------------------------------------------------- */

  .hk-form-error {
    background: var(--hk-error-soft);
    border: 1px solid var(--hk-error);
    border-radius: var(--hk-r-card-sm);
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hk-form-error:focus {
    outline: 2px solid var(--hk-accent);
    outline-offset: 3px;
  }

  .hk-form-error-heading {
    font-size: var(--hk-meta);
    font-weight: 700;
    line-height: 1.2;
    color: var(--hk-ink);
  }

  .hk-form-error-body {
    font-size: var(--hk-body-sm);
    line-height: 1.5;
    color: var(--hk-ink-2);
  }

  /* --- Success -------------------------------------------------------- */

  .hk-form-result {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 24px 8px;
  }

  .hk-form-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--hk-r-pill);
    background: var(--hk-accent-soft);
    color: var(--hk-accent-text);
  }

  .hk-form-icon.is-warning {
    background: var(--hk-hover-tint);
    color: var(--hk-ink-2);
  }

  .hk-form-result-heading {
    font-size: var(--hk-h3);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .hk-form-result-heading:focus {
    outline: 2px solid var(--hk-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* --- Footnote ------------------------------------------------------- */

  .hk-form-note {
    margin-top: 28px;
    padding-top: var(--hk-gap-sm);
    border-top: 1px solid var(--hk-hairline);
    font-size: var(--hk-body-sm);
    line-height: 1.5;
    color: var(--hk-ink-2);
  }

  .hk-form-note a {
    color: var(--hk-accent-text);
    font-weight: 600;
  }

  .hk-form-note a:hover {
    color: var(--hk-accent-strong-hover);
  }

  @media (max-width: 900px) {
    .hk-form-panel {
      padding: 28px;
    }
  }
</style>
