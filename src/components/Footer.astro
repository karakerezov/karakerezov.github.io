---
import { NAV_LINKS, CONTACT_EMAIL, LINKEDIN_URL, BEHANCE_URL } from '../data/nav';
---

<footer class="hk-footer">
  <div class="hk-shell hk-footer-row">
    <div class="hk-footer-brand">
      <a href="/" aria-label="Home">
        <img src="/uploads/Personal%20logo-01.svg" alt="HK" />
      </a>
      <span class="hk-footer-copy">&copy; Hristo Karakerezov</span>
    </div>

    <nav class="hk-footer-nav" aria-label="Footer">
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="hk-footer-social">
      <a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={BEHANCE_URL} target="_blank" rel="noopener noreferrer">Behance</a>
    </div>
  </div>
</footer>

<style>
  .hk-footer {
    font-family: var(--hk-font-body);
    background: transparent;
    border-top: 1px solid var(--hk-hairline);
  }
  .hk-footer-row {
    padding: 48px var(--hk-shell-pad);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px;
    align-items: center;
  }
  .hk-footer-brand { display: flex; flex-direction: column; gap: 12px; justify-self: start; }
  .hk-footer-brand img { height: 24px; width: auto; display: block; }
  .hk-footer-copy { font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); }
  .hk-footer-nav { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; justify-self: center; }
  .hk-footer-nav a { font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink-2); }
  .hk-footer-social { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; justify-self: end; }
  .hk-footer-social a { font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink); }

  @media (max-width: 760px) {
    .hk-footer-row { grid-template-columns: 1fr; text-align: center; }
    .hk-footer-brand, .hk-footer-nav, .hk-footer-social { justify-self: center; justify-content: center; }
  }
</style>
