---
import site from '../data/site.json';
import Logo from './Logo.astro';

const links = [
  { label: 'Email', href: `mailto:${site.email}` },
  ...(site.linkedin ? [{ label: 'LinkedIn', href: site.linkedin }] : []),
  ...(site.behance ? [{ label: 'Behance', href: site.behance }] : []),
];
---

<footer class="hk-footer">
  <div class="hk-shell hk-footer-inner">
    <div class="hk-footer-brand">
      <a href="/" aria-label={site.a11y.homeLink} class="hk-footer-logo">
        <Logo height={site.logoHeightFooter} />
      </a>
      <span class="hk-meta-text">{site.copyright}</span>
    </div>

    <nav class="hk-footer-nav" aria-label="Footer">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="hk-footer-links">
      {
        links.map((link) => (
          <a
            href={link.href}
            rel={link.href.startsWith('http') ? 'me noopener' : undefined}
            target={link.href.startsWith('http') ? '_blank' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .hk-footer {
    background: transparent;
    border-top: 1px solid var(--hk-hairline);
  }

  .hk-footer-inner {
    padding-block: 48px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--hk-gap);
    align-items: center;
  }

  .hk-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-self: start;
  }

  .hk-footer-logo {
    display: flex;
    align-items: center;
  }

  .hk-footer-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-self: center;
  }

  /* 44px minimum on every footer link, at every width. */
  .hk-footer-nav a,
  .hk-footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hk-footer-nav a {
    font-size: var(--hk-meta);
    font-weight: 600;
    line-height: 1;
    color: var(--hk-ink-2);
  }

  .hk-footer-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    justify-self: end;
  }

  .hk-footer-links a {
    font-size: var(--hk-meta);
    font-weight: 600;
    line-height: 1;
    color: var(--hk-ink);
  }

  .hk-footer-nav a:hover,
  .hk-footer-links a:hover {
    color: var(--hk-accent-text);
  }

  @media (max-width: 900px) {
    .hk-footer-inner {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 28px;
    }

    .hk-footer-brand,
    .hk-footer-nav,
    .hk-footer-links {
      justify-self: start;
    }
  }
</style>
