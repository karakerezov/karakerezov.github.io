---
import { NAV_LINKS } from '../data/nav';

interface Props {
  active: 'home' | 'work' | 'archive' | 'about' | 'contact';
  autoHide?: boolean;
}

const { active, autoHide = true } = Astro.props;
---

<header class="hk-header" data-hk-header data-autohide={autoHide ? '1' : '0'}>
  <div class="hk-header-row">
    <a href="/" class="hk-logo" aria-label="Home">
      <img src="/uploads/Personal%20logo-01.svg" alt="HK" />
    </a>
    <div class="hk-header-tools">
      <nav class="hk-nav" aria-label="Primary">
        {NAV_LINKS.map((link) => (
          <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
      <button
        type="button"
        class="hk-scheme-toggle"
        data-hk-theme-toggle
        aria-pressed="false"
        aria-label="Switch to dark appearance"
        data-label-dark="Switch to dark appearance"
        data-label-light="Switch to light appearance"
      >
        <svg class="hk-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="hk-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button type="button" class="hk-nav-toggle" data-hk-nav-toggle aria-label="Open menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </div>
  </div>
</header>

<div class="hk-nav-drawer" data-hk-nav-drawer hidden>
  <button type="button" class="hk-nav-close" data-hk-nav-close aria-label="Close menu">&times;</button>
  {NAV_LINKS.map((link) => (
    <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>
  ))}
</div>
