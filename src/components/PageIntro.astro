---
/**
 * The opening block of every inner page: one large serif heading and a lead
 * paragraph, sitting below the fixed header.
 */
interface Props {
  heading: string;
  lead?: string;
  /** Bottom padding varies a little between pages in the design. */
  bottom?: string;
}

const { heading, lead, bottom = '96px' } = Astro.props;
---

<section class="hk-intro" style={`--intro-bottom:${bottom}`}>
  <h1 class="hk-h1-page">{heading}</h1>
  {lead && <p class="hk-lead hk-intro-lead">{lead}</p>}
</section>

<style>
  .hk-intro {
    padding: var(--hk-page-top) 0 var(--intro-bottom, 96px);
  }

  .hk-intro-lead {
    margin-top: 32px;
    max-width: var(--hk-prose-max);
  }

  @media (max-width: 900px) {
    .hk-intro {
      padding-bottom: 56px;
    }
  }
</style>
