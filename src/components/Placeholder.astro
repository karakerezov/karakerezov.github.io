---
/**
 * The tile shown wherever an image has not been added yet.
 *
 * It is a calm surface-alt rectangle at the correct aspect ratio, so the
 * layout is already the shape it will be once the real photo arrives.
 *
 * While running `npm run dev` the alt text is printed faintly inside the tile,
 * so it is obvious which picture belongs there. On the live site the tile is
 * silent — no text, no icon, nothing that reads as missing content.
 */
interface Props {
  /** What the finished image will show. Used as the dev caption. */
  alt: string;
  /** CSS aspect-ratio value, e.g. "4/5" or "816/1662". */
  ratio?: string;
  /** Fixed height instead of an aspect ratio, for slots the design pins. */
  height?: string;
  class?: string;
}

const { alt, ratio, height, class: className } = Astro.props;
const isDev = import.meta.env.DEV;

const style = [ratio && `aspect-ratio:${ratio}`, height && `height:${height}`]
  .filter(Boolean)
  .join(';');
---

<div class:list={['hk-placeholder', className]} style={style} role="presentation">
  {isDev && <span class="hk-placeholder-caption">{alt}</span>}
</div>

<style>
  .hk-placeholder {
    width: 100%;
    background: var(--hk-surface-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow: hidden;
  }

  .hk-placeholder-caption {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1.45;
    text-align: center;
    /* Quiet, but still readable — it is a note to the author. */
    color: var(--hk-ink-3-text);
    max-width: 32ch;
    text-wrap: balance;
  }
</style>
