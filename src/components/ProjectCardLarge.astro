---
import type { Project } from '../lib/content';
import ProjectMedia from './ProjectMedia.astro';

/** The tall card in the left column of the home-page work grid. */
interface Props {
  project: Project;
  /** True for the first card on the home page — its image loads eagerly. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { data } = project;
const href = `/work/${project.id}`;
const headingId = `project-${project.id}`;
---

<article class="hk-project-card hk-card is-large" aria-labelledby={headingId} data-hk-reveal>
  <ProjectMedia
    cover={data.cover}
    coverAlt={data.coverAlt}
    isProtected={data.protected}
    protectedBadge={data.protectedBadge}
    eager={eager}
    sizes="(max-width: 900px) 92vw, (max-width: 1200px) 50vw, 640px"
  />

  <div class="hk-project-body">
    <div class="hk-project-head">
      <h3 class="hk-project-title" id={headingId}>{data.title}</h3>
      <span class="hk-meta-text">{data.subtitle}</span>
    </div>

    <p class="hk-project-summary">{data.summary}</p>

    <ul class="hk-pill-row">
      {data.tags.map((tag) => <li class="hk-pill">{tag}</li>)}
    </ul>

    <div class="hk-project-cta">
      {
        data.protected ? (
          <>
            <a href={href} class="hk-link">
              {data.cta}
              <span aria-hidden="true">→</span>
            </a>
            {data.protectedNote && <span class="hk-meta-text">{data.protectedNote}</span>}
          </>
        ) : (
          <a href={href} class="hk-btn hk-btn-solid">
            {data.cta}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .hk-project-card {
    padding: var(--hk-card-pad-lg);
    display: flex;
    flex-direction: column;
    gap: 28px;
    transition: var(--hk-t-card);
    /* Shape of the picture well — read by ProjectMedia. */
    --hk-well-min: 460px;
  }

  .hk-project-card:hover {
    transform: var(--hk-lift);
    box-shadow: var(--hk-card-shadow);
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-project-card:hover {
      transform: none;
    }
  }

  .hk-project-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px 12px 12px;
  }

  .hk-project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hk-project-title {
    font-size: var(--hk-h3);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .hk-project-summary {
    font-size: var(--hk-body);
    line-height: 1.55;
    color: var(--hk-ink-2);
    text-wrap: pretty;
  }

  .hk-project-cta {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hk-project-card {
      --hk-well-min: 0;
      --hk-well-ratio: 4 / 3;
      --hk-well-flex: 0 0 auto;
    }
  }
</style>
