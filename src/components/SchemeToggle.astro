---
import site from '../data/site.json';

/**
 * Light / dark switch. Rendered only when site.behavior.darkMode is true.
 * The button starts in the light state and theme.ts corrects it on load,
 * which happens before the user can reach it.
 */
---

<button
  type="button"
  class="hk-scheme-toggle"
  data-hk-theme-toggle
  aria-pressed="false"
  aria-label={site.a11y.toDark}
  data-label-dark={site.a11y.toDark}
  data-label-light={site.a11y.toLight}
>
  <svg
    class="hk-sun"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="hk-moon"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .hk-scheme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    padding: 0;
    color: var(--hk-ink);
    background: transparent;
    border: 1px solid var(--hk-hairline-2);
    border-radius: var(--hk-r-pill);
    cursor: pointer;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.2s ease;
  }

  .hk-scheme-toggle:hover {
    background: var(--hk-hover-tint);
    color: var(--hk-accent-text);
    border-color: var(--hk-hairline-3);
  }

  /* Show the icon for the scheme the button will switch *to*:
     a moon while the page is light, a sun while it is dark. */
  .hk-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .hk-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .hk-sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hk-moon {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .hk-sun {
      display: block;
    }
  }
</style>
