---
/**
 * "The project at a glance" — a short heading beside three labelled notes.
 */
interface Props {
  heading: string;
  body: string;
  items: { label: string; body: string }[];
}

const { heading, body, items } = Astro.props;
---

<div class="hk-cs-glance">
  <div class="hk-cs-glance-copy">
    <h2 class="hk-h2">{heading}</h2>
    <p class="hk-prose">{body}</p>
  </div>
  <dl class="hk-cs-glance-list">
    {
      items.map((item) => (
        <div class="hk-cs-glance-item">
          <dt class="hk-eyebrow-accent">{item.label}</dt>
          <dd class="hk-cs-glance-body">{item.body}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .hk-cs-glance {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .hk-cs-glance-copy {
    display: flex;
    flex-direction: column;
    gap: var(--hk-gap-sm);
  }

  .hk-cs-glance-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  .hk-cs-glance-item {
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline);
    border-radius: var(--hk-r-card-sm);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hk-cs-glance-body {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--hk-ink);
  }

  @media (max-width: 900px) {
    .hk-cs-glance {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>
