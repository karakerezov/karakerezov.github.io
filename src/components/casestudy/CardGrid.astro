---
/**
 * A row of small cards. The design uses this shape repeatedly — for the four
 * friction points, the research insights, the accessibility notes and the
 * outcomes — varying only the column count and whether the cards are numbered.
 */
interface Props {
  items: { n?: string; title: string; body?: string }[];
  /** Columns on a wide screen. */
  cols?: 2 | 3 | 4;
  /** `surface` is the white card; `alt` is the filled grey one. */
  tone?: 'surface' | 'alt';
  /** Size of the card title. */
  titleSize?: 'sm' | 'md';
  /** Heading level for the card titles. */
  headingLevel?: 'h3' | 'h4';
  /** Numbers in the accent colour, or the quieter grey used for the trio. */
  numberTone?: 'accent' | 'muted';
}

const { items, cols = 3, tone = 'surface', titleSize = 'sm', numberTone = 'accent' } = Astro.props;
const Heading = Astro.props.headingLevel ?? 'h3';
---

<ul class="hk-cs-cards" class:list={[`is-${tone}`, `cols-${cols}`]}>
  {
    items.map((item) => (
      <li class="hk-cs-card">
        {item.n && <span class:list={['hk-cs-number', `is-${numberTone}`]}>{item.n}</span>}
        <Heading class:list={['hk-cs-card-title', `is-${titleSize}`]}>{item.title}</Heading>
        {item.body && <p class="hk-cs-card-body">{item.body}</p>}
      </li>
    ))
  }
</ul>

<style>
  .hk-cs-cards {
    display: grid;
    gap: var(--hk-gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .cols-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .hk-cs-card {
    border-radius: var(--hk-r-media);
    padding: var(--hk-card-pad-lg);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .is-surface .hk-cs-card {
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline);
  }

  .is-alt .hk-cs-card {
    background: var(--hk-surface-alt);
  }

  /* The two-column variants use roomier cards, as in the design. */
  .cols-2 .hk-cs-card {
    padding: 40px;
    gap: 12px;
  }

  .cols-3.is-surface .hk-cs-card {
    padding: 40px;
  }

  .cols-4 .hk-cs-card {
    gap: 14px;
  }

  .hk-cs-number {
    font-family: var(--hk-font-display);
    font-size: 24px;
    line-height: 1;
  }

  .hk-cs-number.is-accent {
    color: var(--hk-accent);
  }

  .hk-cs-number.is-muted {
    color: var(--hk-ink-3-text);
  }

  .hk-cs-card-title {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hk-cs-card-title.is-sm {
    font-size: var(--hk-body);
    line-height: 1.25;
  }

  .hk-cs-card-title.is-md {
    font-size: var(--hk-h3-sm);
    line-height: 1.2;
  }

  .hk-cs-card-body {
    font-size: var(--hk-body-sm);
    line-height: 1.5;
    color: var(--hk-ink-2);
  }

  .cols-2 .hk-cs-card-body {
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 1200px) {
    .cols-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .cols-2,
    .cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hk-cs-card,
    .cols-2 .hk-cs-card,
    .cols-3.is-surface .hk-cs-card {
      padding: 28px;
    }
  }

  @media (max-width: 600px) {
    .cols-2,
    .cols-3,
    .cols-4 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
