---
/**
 * A full-width pause between parts of the study — one large statement and a
 * sentence of context, with nothing else competing for attention.
 */
interface Props {
  heading: string;
  body: string;
  /** `md` for "Starting the design", `lg` for the hi-fi transition. */
  size?: 'md' | 'lg';
  balance?: boolean;
}

const { heading, body, size = 'md', balance = false } = Astro.props;
---

<div class="hk-cs-intro" class:list={[`is-${size}`]}>
  <h2 class="hk-cs-intro-heading" class:list={[balance && 'is-balanced']}>{heading}</h2>
  <p class="hk-lead">{body}</p>
</div>

<style>
  .hk-cs-intro {
    display: flex;
    flex-direction: column;
    gap: var(--hk-gap-sm);
  }

  .hk-cs-intro.is-md {
    max-width: 820px;
  }

  .hk-cs-intro.is-lg {
    max-width: 900px;
  }

  .hk-cs-intro-heading {
    font-family: var(--hk-font-display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .is-md .hk-cs-intro-heading {
    font-size: var(--hk-h2-lg);
  }

  .is-lg .hk-cs-intro-heading {
    font-size: clamp(44px, 5vw, 72px);
  }

  .hk-cs-intro-heading.is-balanced {
    text-wrap: balance;
  }
</style>
