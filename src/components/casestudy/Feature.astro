---
import Screen from './Screen.astro';

/**
 * A screen set beside the point it makes. Three tones cover every use in the
 * design: a plain pairing, a filled accent panel, and a white card.
 */
interface Props {
  /** `plain` no panel, `accent` tinted panel, `card` white card. */
  tone?: 'plain' | 'accent' | 'card';
  image?: string | undefined;
  imageAlt: string;
  imageWidth?: string;
  /** Put the picture on the right instead of the left. */
  imageRight?: boolean;
  /** Column ratio, e.g. "1fr 1.1fr". */
  columns?: string;
  eyebrow?: string;
  heading?: string;
  headingSize?: 'md' | 'lg';
  quote?: string;
  lead?: string;
  body?: string;
  /** A second, smaller screen under the copy. */
  inset?: { image?: string; alt: string; width?: string };
}

const {
  tone = 'plain',
  image,
  imageAlt,
  imageWidth = '60%',
  imageRight = false,
  columns = '1fr 1fr',
  eyebrow,
  heading,
  headingSize = 'md',
  quote,
  lead,
  body,
  inset,
} = Astro.props;
---

<div
  class="hk-cs-feature"
  class:list={[`is-${tone}`, imageRight && 'is-reversed']}
  style={`--cols:${columns}`}
>
  <div class="hk-cs-feature-media">
    <Screen
      src={image}
      alt={imageAlt}
      width={imageWidth}
      shadow="lg"
      sizes="(max-width: 900px) 60vw, 320px"
    />
  </div>

  <div class="hk-cs-feature-copy">
    {eyebrow && <p class="hk-eyebrow">{eyebrow}</p>}
    {heading && <h3 class:list={['hk-cs-feature-heading', `is-${headingSize}`]}>{heading}</h3>}
    {quote && <p class="hk-cs-feature-quote">{quote}</p>}
    {lead && <p class="hk-cs-feature-lead">{lead}</p>}
    {body && <p class="hk-cs-feature-body">{body}</p>}
    {
      inset && (
        <Screen
          src={inset.image}
          alt={inset.alt}
          width={inset.width ?? '40%'}
          shadow="sm"
          centred={false}
          sizes="(max-width: 900px) 35vw, 160px"
        />
      )
    }
  </div>
</div>

<style>
  .hk-cs-feature {
    display: grid;
    grid-template-columns: var(--cols, 1fr 1fr);
    gap: 48px;
    align-items: center;
  }

  .hk-cs-feature.is-accent {
    background: var(--hk-accent-soft);
    border: 1px solid var(--hk-accent-line);
    border-radius: var(--hk-r-card);
    padding: 56px;
  }

  .hk-cs-feature.is-card {
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline);
    border-radius: var(--hk-r-card);
    padding: 56px;
  }

  .hk-cs-feature.is-reversed .hk-cs-feature-media {
    order: 1;
  }

  .hk-cs-feature-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hk-cs-feature-heading {
    font-family: var(--hk-font-display);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .hk-cs-feature-heading.is-md {
    font-size: var(--hk-h4);
    line-height: 1.05;
  }

  .hk-cs-feature-heading.is-lg {
    font-size: clamp(32px, 3.4vw, 44px);
    line-height: 1.1;
    text-wrap: balance;
  }

  .hk-cs-feature-quote {
    font-family: var(--hk-font-display);
    font-size: 32px;
    line-height: 1.2;
    color: var(--hk-ink);
  }

  .hk-cs-feature-lead {
    font-size: 20px;
    line-height: 1.4;
    color: var(--hk-ink);
    font-weight: 600;
  }

  .hk-cs-feature-body {
    font-size: 16px;
    line-height: 1.55;
    color: var(--hk-ink-2);
  }

  .hk-cs-feature-body :global(strong) {
    color: var(--hk-ink);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .hk-cs-feature {
      grid-template-columns: minmax(0, 1fr) !important;
      gap: var(--hk-gap);
    }

    .hk-cs-feature.is-accent,
    .hk-cs-feature.is-card {
      padding: 32px 24px;
    }

    .hk-cs-feature.is-reversed .hk-cs-feature-media {
      order: -1;
    }

    .hk-cs-feature-quote {
      font-size: 26px;
    }
  }
</style>
