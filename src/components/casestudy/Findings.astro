---
/**
 * What the usability sessions turned up: for each finding, what was said, what
 * it meant, and what changed as a result.
 */
interface Props {
  items: { tag: string; title: string; quote: string; insight: string; response: string }[];
  labels: { insight: string; response: string };
}

const { items, labels } = Astro.props;
---

<ul class="hk-cs-findings">
  {
    items.map((item) => (
      <li class="hk-cs-finding hk-card-sm">
        <p class="hk-eyebrow-accent">{item.tag}</p>
        <h3 class="hk-cs-finding-title">{item.title}</h3>
        <blockquote class="hk-cs-finding-quote">
          <p>“{item.quote}”</p>
        </blockquote>
        <div class="hk-cs-finding-note">
          <p class="hk-eyebrow">{labels.insight}</p>
          <p class="hk-cs-finding-body is-muted">{item.insight}</p>
        </div>
        <div class="hk-cs-finding-note">
          <p class="hk-eyebrow is-accent">{labels.response}</p>
          <p class="hk-cs-finding-body">{item.response}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .hk-cs-findings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hk-gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hk-cs-finding {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hk-cs-finding-title {
    font-size: var(--hk-h3-sm);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hk-cs-finding-quote p {
    font-family: var(--hk-font-display);
    font-size: var(--hk-h3-sm);
    line-height: 1.3;
    color: var(--hk-ink);
  }

  .hk-cs-finding-note {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hk-eyebrow.is-accent {
    color: var(--hk-accent-text);
    letter-spacing: 0.05em;
  }

  .hk-cs-finding-body {
    font-size: var(--hk-body-sm);
    line-height: 1.5;
    color: var(--hk-ink);
  }

  .hk-cs-finding-body.is-muted {
    color: var(--hk-ink-2);
  }

  @media (max-width: 900px) {
    .hk-cs-findings {
      grid-template-columns: minmax(0, 1fr);
    }
    .hk-cs-finding {
      padding: 28px;
    }
  }
</style>
