---
import site from '../../data/site.json';
import Screen from './Screen.astro';

/**
 * The opening of the case study: the project name, its one-line promise, the
 * facts of the job, and three product screens fanned out beside them.
 */
interface Props {
  eyebrow: string;
  title: string;
  promise: string;
  intro: string;
  meta: { label: string; value: string }[];
  /** Empty string hides the prototype button. */
  prototypeUrl?: string;
  exploreHref?: string;
  exploreLabel: string;
  screens: { src?: string; alt: string }[];
}

const {
  eyebrow,
  title,
  promise,
  intro,
  meta,
  prototypeUrl = '',
  exploreHref = '#story',
  exploreLabel,
  screens,
} = Astro.props;
---

<section class="hk-cs-hero">
  <div class="hk-cs-hero-copy">
    <p class="hk-cs-eyebrow">{eyebrow}</p>
    <h1 class="hk-cs-title">{title}</h1>
    <p class="hk-cs-promise">{promise}</p>
    <p class="hk-prose hk-cs-intro">{intro}</p>

    <dl class="hk-cs-meta">
      {
        meta.map((item) => (
          <div class="hk-cs-meta-item">
            <dt class="hk-eyebrow">{item.label}</dt>
            <dd class="hk-cs-meta-value">{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="hk-cs-hero-actions">
      {
        prototypeUrl && (
          <a href={prototypeUrl} class="hk-btn hk-btn-accent" rel="noopener" target="_blank">
            {site.work.prototypeCta}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
      <a href={exploreHref} class="hk-link">
        {exploreLabel}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>

  <div class="hk-cs-hero-screens">
    {
      screens.map((screen, index) => (
        <div class="hk-cs-hero-screen" class:list={[`is-${index}`]}>
          <Screen
            src={screen.src}
            alt={screen.alt}
            width="100%"
            shadow={index === 1 ? 'lg' : 'md'}
            centred={false}
            sizes="(max-width: 900px) 30vw, 240px"
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .hk-cs-hero {
    padding: 180px 0 96px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .hk-cs-hero-copy {
    display: flex;
    flex-direction: column;
  }

  .hk-cs-eyebrow {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hk-accent-text);
  }

  .hk-cs-title {
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: var(--hk-h1-case);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: var(--hk-gap-sm);
  }

  .hk-cs-promise {
    margin-top: var(--hk-gap-sm);
    font-size: var(--hk-lead);
    line-height: 1.45;
    color: var(--hk-ink);
    font-weight: 600;
    max-width: 520px;
  }

  .hk-cs-intro {
    margin-top: 20px;
    max-width: 520px;
  }

  .hk-cs-meta {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 28px 48px;
    justify-content: start;
  }

  .hk-cs-meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hk-cs-meta-value {
    margin: 0;
    font-size: var(--hk-meta);
    font-weight: 600;
    color: var(--hk-ink);
  }

  .hk-cs-hero-actions {
    margin-top: 44px;
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  /* --- The fanned screens ------------------------------------------- */

  .hk-cs-hero-screens {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 520px;
  }

  .hk-cs-hero-screen {
    position: relative;
  }

  .hk-cs-hero-screen.is-0 {
    z-index: 1;
    width: 40%;
    margin-right: -6%;
    transform: translateY(24px);
  }

  .hk-cs-hero-screen.is-1 {
    z-index: 3;
    width: 52%;
  }

  .hk-cs-hero-screen.is-2 {
    z-index: 1;
    width: 40%;
    margin-left: -6%;
    transform: translateY(24px);
  }

  @media (max-width: 900px) {
    .hk-cs-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding: calc(var(--hk-page-top) - 20px) 0 64px;
    }

    .hk-cs-hero-screens {
      min-height: 0;
    }

    .hk-cs-meta {
      gap: 24px 32px;
    }
  }
</style>
