---
/**
 * The six stages of a weekly shop, with what the user does, thinks, struggles
 * with and what that opens up. Wider than the page on small screens, so it
 * scrolls sideways inside its own box and is reachable by keyboard.
 */
interface Props {
  stages: {
    stage: string;
    action: string;
    thought: string;
    friction: string;
    opportunity: string;
    emotion: string;
    /** `warm` = strongest friction, `mid` = some, `calm` = none. */
    tone: 'warm' | 'mid' | 'calm';
  }[];
  labels: { action: string; thinking: string; friction: string; opportunity: string };
  scrollHint: string;
}

const { stages, labels, scrollHint } = Astro.props;
---

<div class="hk-cs-journey" tabindex="0" role="group" aria-label={scrollHint}>
  <ol class="hk-cs-journey-track" style={`--stages:${stages.length}`}>
    {
      stages.map((stage) => (
        <li class="hk-cs-journey-stage" class:list={[`tone-${stage.tone}`]}>
          <div class="hk-cs-journey-top">
            <span class="hk-cs-journey-dot" aria-hidden="true" />
            <span class="hk-cs-journey-name">{stage.stage}</span>
          </div>
          <div class="hk-cs-journey-rule" aria-hidden="true" />

          <dl class="hk-cs-journey-card">
            <dt class="hk-cs-journey-label">{labels.action}</dt>
            <dd class="hk-cs-journey-value">{stage.action}</dd>

            <dt class="hk-cs-journey-label is-spaced">{labels.thinking}</dt>
            <dd class="hk-cs-journey-value is-quote">“{stage.thought}”</dd>

            <dt class="hk-cs-journey-label is-spaced">{labels.friction}</dt>
            <dd class="hk-cs-journey-value is-muted">{stage.friction}</dd>

            <dt class="hk-cs-journey-label is-spaced is-accent">{labels.opportunity}</dt>
            <dd class="hk-cs-journey-value">{stage.opportunity}</dd>
          </dl>

          <p class="hk-cs-journey-emotion">{stage.emotion}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .hk-cs-journey {
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .hk-cs-journey:focus-visible {
    outline: 2px solid var(--hk-accent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  .hk-cs-journey-track {
    display: grid;
    grid-template-columns: repeat(var(--stages, 6), minmax(190px, 1fr));
    gap: 16px;
    min-width: 760px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Each stage carries its own emotional temperature. The dot can be the
   * bright design colour, but the emotion beneath it is real text, so it uses
   * a darkened companion that clears 4.5:1 on the page background.
   */
  .hk-cs-journey-stage {
    display: flex;
    flex-direction: column;
    gap: 14px;
    --tone: var(--hk-accent);
    --tone-text: var(--hk-accent-text);
  }

  .tone-warm {
    --tone: #c7264b;
    --tone-text: #c7264b;
  }
  .tone-mid {
    --tone: #f6be45;
    --tone-text: #8a6100;
  }
  .tone-calm {
    --tone: var(--hk-accent);
    --tone-text: var(--hk-accent-text);
  }

  /* On the dark background the bright hues are already legible as text. */
  :global(:root[data-theme='dark']) .tone-warm {
    --tone: #ff8098;
    --tone-text: #ff8098;
  }
  :global(:root[data-theme='dark']) .tone-mid {
    --tone-text: #f6be45;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .tone-warm {
      --tone: #ff8098;
      --tone-text: #ff8098;
    }
    :global(:root:not([data-theme='light'])) .tone-mid {
      --tone-text: #f6be45;
    }
  }

  .hk-cs-journey-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hk-cs-journey-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--hk-r-pill);
    background: var(--tone);
    flex-shrink: 0;
  }

  .hk-cs-journey-name {
    font-size: var(--hk-meta);
    font-weight: 700;
    line-height: 1;
    color: var(--hk-ink);
  }

  .hk-cs-journey-rule {
    height: 1px;
    background: var(--hk-hairline-2);
  }

  .hk-cs-journey-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline);
    border-radius: var(--hk-r-card-sm);
    padding: 20px;
    margin: 0;
    /* Equal heights keep the emotion labels on one line across the map. */
    flex: 1;
  }

  .hk-cs-journey-label {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    color: var(--hk-ink-3-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hk-cs-journey-label.is-spaced {
    margin-top: 6px;
  }

  .hk-cs-journey-label.is-accent {
    color: var(--hk-accent-text);
  }

  .hk-cs-journey-value {
    margin: 0;
    font-size: var(--hk-body-xs);
    line-height: 1.45;
    color: var(--hk-ink);
  }

  .hk-cs-journey-value.is-quote {
    color: var(--hk-ink-2);
    font-style: italic;
  }

  .hk-cs-journey-value.is-muted {
    color: var(--hk-ink-2);
  }

  .hk-cs-journey-emotion {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    text-align: center;
    color: var(--tone-text);
  }
</style>
