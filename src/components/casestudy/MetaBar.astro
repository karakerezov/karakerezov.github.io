---
/**
 * The facts of the job under a case-study heading. Entries with no value are
 * left out, so a half-filled project does not show empty columns.
 */
interface Props {
  items: { label: string; value: string }[];
}

const items = Astro.props.items.filter((item) => item.value.trim() !== '');
---

{
  items.length > 0 && (
    <dl class="hk-metabar">
      {items.map((item) => (
        <div class="hk-metabar-item">
          <dt class="hk-eyebrow">{item.label}</dt>
          <dd class="hk-metabar-value">{item.value}</dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .hk-metabar {
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--hk-gap-sm);
    border-top: 1px solid var(--hk-hairline);
    padding-top: var(--hk-card-pad-lg);
  }

  .hk-metabar-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hk-metabar-value {
    margin: 0;
    font-size: var(--hk-meta);
    line-height: 1.5;
    color: var(--hk-ink);
    font-weight: 600;
  }
</style>
