---
/**
 * The centred passage that sets up the whole study, ending on a pull quote.
 */
interface Props {
  heading: string;
  body: string;
  quote: string;
}

const { heading, body, quote } = Astro.props;
---

<div class="hk-cs-story">
  <h2 class="hk-cs-story-heading">{heading}</h2>
  <p class="hk-cs-story-body">{body}</p>
  <blockquote class="hk-cs-quote">
    <p>{quote}</p>
  </blockquote>
</div>

<style>
  .hk-cs-story {
    max-width: var(--hk-content-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--hk-gap);
  }

  .hk-cs-story-heading {
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hk-cs-story-body {
    font-size: var(--hk-body);
    line-height: 1.6;
    color: var(--hk-ink-2);
    text-wrap: pretty;
  }

  .hk-cs-quote {
    background: var(--hk-accent-soft);
    border-radius: var(--hk-r-media);
    padding: 48px;
  }

  .hk-cs-quote p {
    font-family: var(--hk-font-display);
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--hk-ink);
  }

  @media (max-width: 600px) {
    .hk-cs-quote {
      padding: 32px 24px;
    }
    .hk-cs-quote p {
      font-size: 26px;
    }
  }
</style>
