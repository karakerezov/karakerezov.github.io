---
import Media from '../Media.astro';

/**
 * The primary persona: a portrait, a quote in their own words, and four short
 * facts about how they shop.
 */
interface Props {
  eyebrow: string;
  name: string;
  role: string;
  quote: string;
  facts: { label: string; body: string }[];
  image?: string | undefined;
  imageAlt: string;
}

const { eyebrow, name, role, quote, facts, image, imageAlt } = Astro.props;
---

<div class="hk-cs-persona hk-card">
  <div class="hk-cs-persona-photo">
    <Media src={image} alt={imageAlt} sizes="(max-width: 900px) 92vw, 35vw" />
  </div>

  <div class="hk-cs-persona-body">
    <div class="hk-cs-persona-id">
      <p class="hk-eyebrow-accent">{eyebrow}</p>
      <h3 class="hk-cs-persona-name">{name}</h3>
      <p class="hk-cs-persona-role">{role}</p>
    </div>

    <blockquote class="hk-cs-persona-quote">
      <p>{quote}</p>
    </blockquote>

    <dl class="hk-cs-persona-facts">
      {
        facts.map((fact) => (
          <div class="hk-cs-persona-fact">
            <dt class="hk-eyebrow">{fact.label}</dt>
            <dd class="hk-cs-persona-fact-body">{fact.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<style>
  .hk-cs-persona {
    padding: var(--hk-gap-sm);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 40px;
    align-items: stretch;
  }

  .hk-cs-persona-photo {
    border-radius: var(--hk-r-media);
    overflow: hidden;
    background: var(--hk-surface-alt);
    position: relative;
    min-height: 440px;
  }

  .hk-cs-persona-photo :global(img),
  .hk-cs-persona-photo :global(.hk-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--hk-media-filter);
  }

  .hk-cs-persona-body {
    display: flex;
    flex-direction: column;
    gap: var(--hk-gap-sm);
    padding: 24px 32px 24px 8px;
  }

  .hk-cs-persona-id {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hk-cs-persona-name {
    margin-top: 6px;
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hk-cs-persona-role {
    font-size: var(--hk-meta);
    color: var(--hk-ink-2);
  }

  .hk-cs-persona-quote {
    border-left: 2px solid var(--hk-accent);
    padding-left: 20px;
  }

  .hk-cs-persona-quote p {
    font-family: var(--hk-font-display);
    font-size: var(--hk-h3-sm);
    line-height: 1.25;
    color: var(--hk-ink);
  }

  .hk-cs-persona-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hk-gap-sm);
    margin: 0;
  }

  .hk-cs-persona-fact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hk-cs-persona-fact-body {
    margin: 0;
    font-size: var(--hk-body-sm);
    line-height: 1.5;
    color: var(--hk-ink);
  }

  @media (max-width: 900px) {
    .hk-cs-persona {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--hk-gap-sm);
    }

    .hk-cs-persona-photo {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .hk-cs-persona-body {
      padding: 8px 8px 16px;
    }

    .hk-cs-persona-facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
