---
/**
 * A run of labels. Used for the delivery phases (each with a dot), the profile
 * capabilities and the list of interactive pieces built in Figma.
 */
interface Props {
  items: string[];
  /** `dot` shows an accent bullet; `plain` and `outline` are quieter. */
  variant?: 'dot' | 'plain' | 'outline';
}

const { items, variant = 'plain' } = Astro.props;
---

<ul class="hk-cs-pills" class:list={[`is-${variant}`]}>
  {
    items.map((item) => (
      <li class="hk-cs-pill">
        {variant === 'dot' && <span class="hk-cs-pill-dot" aria-hidden="true" />}
        {item}
      </li>
    ))
  }
</ul>

<style>
  .hk-cs-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .is-dot {
    gap: 12px;
  }

  .hk-cs-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--hk-body-xs);
    font-weight: 600;
    border-radius: var(--hk-r-pill);
    padding: 11px 18px;
  }

  .is-dot .hk-cs-pill {
    font-size: var(--hk-meta);
    color: var(--hk-ink);
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline);
    padding: 12px 22px;
  }

  .is-plain .hk-cs-pill {
    color: var(--hk-ink);
    background: var(--hk-surface);
  }

  .is-outline .hk-cs-pill {
    color: var(--hk-ink-2);
    background: var(--hk-pill-fill);
    border: 1px solid var(--hk-hairline-2);
  }

  .hk-cs-pill-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--hk-r-pill);
    background: var(--hk-accent);
    flex-shrink: 0;
  }
</style>
