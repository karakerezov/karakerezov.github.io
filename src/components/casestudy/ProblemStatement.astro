---
/**
 * The problem statement and the "how might we" question, set large and centred
 * on a filled panel. The two emphasised phrases are marked up as <strong> so
 * the emphasis survives without colour.
 */
interface Props {
  /** Text split around the emphasised phrases, in order. */
  parts: string[];
  /** The phrases to emphasise, one fewer than `parts`. */
  emphasis: string[];
  question: string;
}

const { parts, emphasis, question } = Astro.props;
---

<div class="hk-cs-problem">
  <p class="hk-cs-problem-text">
    {
      parts.map((part, index) => (
        <>
          {part}
          {emphasis[index] && <strong>{emphasis[index]}</strong>}
        </>
      ))
    }
  </p>
  <h2 class="hk-cs-problem-question">{question}</h2>
</div>

<style>
  .hk-cs-problem {
    background: var(--hk-surface-alt);
    border-radius: var(--hk-r-card);
    padding: 96px 64px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
    text-align: center;
  }

  .hk-cs-problem-text {
    max-width: 900px;
    font-size: var(--hk-h3);
    line-height: 1.5;
    color: var(--hk-ink);
    text-wrap: pretty;
  }

  .hk-cs-problem-text strong {
    color: var(--hk-accent-text);
    font-weight: 700;
  }

  .hk-cs-problem-question {
    max-width: 840px;
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    .hk-cs-problem {
      padding: 56px 28px;
      gap: 28px;
    }
    .hk-cs-problem-text {
      font-size: var(--hk-lead);
    }
  }
</style>
