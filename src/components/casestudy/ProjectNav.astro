---
import site from '../../data/site.json';

/**
 * The row at the foot of a detail page: the neighbouring projects on each side
 * and a way back to the list in the middle.
 */
interface Props {
  prev?: { href: string; title: string } | undefined;
  next?: { href: string; title: string } | undefined;
  backHref: string;
  backLabel: string;
}

const { prev, next, backHref, backLabel } = Astro.props;
---

<nav class="hk-cs-nav" aria-label={backLabel}>
  <div class="hk-cs-nav-row">
    {
      prev ? (
        <a href={prev.href} class="hk-link hk-cs-nav-side">
          <span aria-hidden="true">←</span>
          <span class="hk-cs-nav-text">
            <span class="hk-cs-nav-label">{site.work.previousProject}</span>
            <span class="hk-cs-nav-title">{prev.title}</span>
          </span>
        </a>
      ) : (
        <span class="hk-cs-nav-side" />
      )
    }

    <a href={backHref} class="hk-btn hk-btn-ghost">{backLabel}</a>

    {
      next ? (
        <a href={next.href} class="hk-link hk-cs-nav-side is-next">
          <span class="hk-cs-nav-text">
            <span class="hk-cs-nav-label">{site.work.nextProject}</span>
            <span class="hk-cs-nav-title">{next.title}</span>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="hk-cs-nav-side" />
      )
    }
  </div>
</nav>

<style>
  .hk-cs-nav-row {
    border-top: 1px solid var(--hk-hairline);
    padding-top: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hk-gap);
    flex-wrap: wrap;
  }

  .hk-cs-nav-side {
    flex: 1;
    min-width: 0;
  }

  .hk-cs-nav-side.is-next {
    justify-content: flex-end;
    text-align: right;
  }

  .hk-cs-nav-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .hk-cs-nav-label {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    color: var(--hk-ink-3-text);
  }

  .hk-cs-nav-title {
    font-size: var(--hk-meta);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .hk-cs-nav-row {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .hk-cs-nav-side.is-next {
      justify-content: flex-start;
      text-align: left;
      flex-direction: row-reverse;
    }
  }
</style>
