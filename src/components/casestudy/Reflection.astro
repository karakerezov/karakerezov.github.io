---
import site from '../../data/site.json';
import Screen from './Screen.astro';

/**
 * The closing statement, the two ways onward, and a last look at three screens.
 */
interface Props {
  heading: string;
  body: string;
  prototypeUrl?: string;
  backHref?: string;
  screens: { image?: string; alt: string }[];
}

const { heading, body, prototypeUrl = '', backHref = '/work', screens } = Astro.props;
---

<div class="hk-cs-reflection">
  <div class="hk-cs-reflection-copy">
    <h2 class="hk-cs-reflection-heading">{heading}</h2>
    <p class="hk-cs-reflection-body">{body}</p>
    <div class="hk-cs-reflection-actions">
      {
        prototypeUrl && (
          <a href={prototypeUrl} class="hk-btn hk-btn-accent" rel="noopener" target="_blank">
            {site.work.prototypeCta}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
      <a href={backHref} class="hk-btn hk-btn-ghost">{site.work.backToIndex}</a>
    </div>
  </div>

  <div class="hk-cs-reflection-screens">
    {
      screens.map((screen) => (
        <Screen
          src={screen.image}
          alt={screen.alt}
          width="100%"
          centred={false}
          sizes="(max-width: 900px) 28vw, 260px"
        />
      ))
    }
  </div>
</div>

<style>
  .hk-cs-reflection-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--hk-gap);
    margin-bottom: 64px;
  }

  .hk-cs-reflection-heading {
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 1000px;
    text-wrap: balance;
  }

  .hk-cs-reflection-body {
    font-size: var(--hk-body);
    line-height: 1.6;
    color: var(--hk-ink-2);
    max-width: var(--hk-prose-max);
    text-wrap: pretty;
  }

  .hk-cs-reflection-actions {
    display: flex;
    align-items: center;
    gap: var(--hk-gap-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .hk-cs-reflection-screens {
    display: flex;
    gap: var(--hk-gap);
    justify-content: center;
    align-items: flex-end;
  }

  .hk-cs-reflection-screens > :global(*) {
    width: 22%;
  }

  @media (max-width: 900px) {
    .hk-cs-reflection-screens {
      gap: 16px;
    }
    .hk-cs-reflection-screens > :global(*) {
      width: 30%;
    }
  }
</style>
