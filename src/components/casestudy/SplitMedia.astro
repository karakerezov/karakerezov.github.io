---
import Media from '../Media.astro';

/**
 * A block of copy beside one large picture. Used for "Understanding the user".
 */
interface Props {
  heading: string;
  lead: string;
  pills?: string[];
  note?: string;
  image?: string | undefined;
  imageAlt: string;
  /** Put the picture on the left instead. */
  flip?: boolean;
}

const { heading, lead, pills = [], note, image, imageAlt, flip = false } = Astro.props;
---

<div class="hk-cs-split" class:list={[flip && 'is-flipped']}>
  <div class="hk-cs-split-copy">
    <h2 class="hk-cs-split-heading">{heading}</h2>
    <p class="hk-lead">{lead}</p>
    {
      pills.length > 0 && (
        <ul class="hk-pill-row hk-cs-split-pills">
          {pills.map((pill) => (
            <li class="hk-pill hk-pill-lg">{pill}</li>
          ))}
        </ul>
      )
    }
    {note && <p class="hk-cs-split-note">{note}</p>}
  </div>

  <div class="hk-cs-split-media">
    <Media src={image} alt={imageAlt} sizes="(max-width: 900px) 92vw, 45vw" />
  </div>
</div>

<style>
  .hk-cs-split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .hk-cs-split.is-flipped .hk-cs-split-media {
    order: -1;
  }

  .hk-cs-split-copy {
    display: flex;
    flex-direction: column;
    gap: var(--hk-gap-sm);
  }

  .hk-cs-split-heading {
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: var(--hk-h2-lg);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hk-cs-split-pills {
    margin-top: 8px;
  }

  .hk-cs-split-note {
    margin-top: 8px;
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1.4;
    color: var(--hk-ink-3-text);
  }

  .hk-cs-split-media {
    border-radius: var(--hk-r-card);
    overflow: hidden;
    background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline);
    height: 480px;
    position: relative;
  }

  .hk-cs-split-media :global(img),
  .hk-cs-split-media :global(.hk-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--hk-media-filter);
  }

  @media (max-width: 900px) {
    .hk-cs-split {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .hk-cs-split-media {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
