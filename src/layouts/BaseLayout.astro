---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'work' | 'archive' | 'about' | 'contact';
  autoHideHeader?: boolean;
}

const { title, description, active, autoHideHeader = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Applies the stored appearance before the first paint, so the page never
      flashes light before switching to dark. Deliberately inline and blocking.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('hk-theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* storage unavailable — fall back to the OS preference */
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/uploads/Personal%20logo-01.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F7F7F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121312" media="(prefers-color-scheme: dark)" />
    <script src="/scripts/theme.js" defer></script>
  </head>
  <body>
    <a href="#top" class="hk-skip-link">Skip to content</a>
    <Header active={active} autoHide={autoHideHeader} />
    <main id="top">
      <slot />
    </main>
    <Footer />
  </body>
</html>
