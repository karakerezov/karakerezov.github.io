---
import site from '../data/site.json';
import Base from './Base.astro';
import ContactCta from '../components/ContactCta.astro';
import ProjectNav from '../components/casestudy/ProjectNav.astro';
import type { Project } from '../lib/content';

/**
 * Wraps a case-study body. The page itself supplies the sections; this adds
 * the head, the surrounding chrome and the move on to the next project.
 */
interface Props {
  project: Project;
  prev?: { href: string; title: string } | undefined;
  next?: { href: string; title: string } | undefined;
  jsonLd?: string | undefined;
  draft?: boolean;
}

const { project, prev, next, jsonLd, draft = false } = Astro.props;
const { data } = project;

const description = data.description || data.summaryIndex || data.summary;
---

<Base
  title={`${data.title} — ${data.subtitle}`}
  description={description}
  ogImage={data.cover}
  ogType="article"
  jsonLd={jsonLd}
  active="/work"
  draft={draft}
>
  <article class="hk-shell hk-casestudy">
    <slot />

    <div class="hk-casestudy-nav">
      <ProjectNav prev={prev} next={next} backHref="/work" backLabel={site.work.backToIndex} />
    </div>
  </article>

  <div class="hk-shell">
    <ContactCta variant="rule" />
  </div>
</Base>

<style>
  .hk-casestudy {
    display: block;
  }

  .hk-casestudy-nav {
    padding-bottom: 96px;
  }
</style>
