---
import site from '../data/site.json';
import Base from '../layouts/Base.astro';
---

<Base title={site.notFound.heading} description={site.notFound.lead} noindex>
  <div class="hk-shell hk-404">
    <p class="hk-404-code">404</p>
    <h1 class="hk-h1-page">{site.notFound.heading}</h1>
    <p class="hk-lead hk-404-lead">{site.notFound.lead}</p>

    <nav class="hk-404-links" aria-label={site.notFound.heading}>
      <a href="/" class="hk-btn hk-btn-solid">
        {site.notFound.cta}
        <span aria-hidden="true">→</span>
      </a>
      {
        site.nav.map((item) => (
          <a href={item.href} class="hk-btn hk-btn-ghost">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</Base>

<style>
  .hk-404 {
    padding: var(--hk-page-top) 0 128px;
    max-width: 760px;
  }

  .hk-404-code {
    font-family: var(--hk-font-display);
    font-size: 96px;
    line-height: 1;
    color: var(--hk-ink-3-text);
  }

  .hk-404-lead {
    margin-top: 24px;
  }

  .hk-404-links {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
