---
import { getEntry, render } from 'astro:content';
import site from '../data/site.json';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactCta from '../components/ContactCta.astro';
import Media from '../components/Media.astro';
import { breadcrumbSchema, personSchema, graph } from '../lib/schema';

const about = await getEntry('about', 'about');
if (!about) throw new Error('src/content/about.md is missing.');
const { Content } = await render(about);
const { data } = about;

const jsonLd = graph([
  personSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: data.title, path: '/about' },
  ]),
]);
---

<Base
  title={data.title}
  description={site.about.description}
  ogType="profile"
  jsonLd={jsonLd}
  active="/about"
>
  <div class="hk-shell">
    <PageIntro heading={data.title} lead={data.lead} />

    <section class="hk-story" data-hk-reveal aria-label={data.title}>
      <div class="hk-story-prose">
        <Content />
      </div>
      <div class="hk-portrait">
        <Media src={data.portrait} alt={data.portraitAlt} sizes="(max-width: 900px) 92vw, 45vw" />
      </div>
    </section>

    <section class="hk-block" data-hk-reveal aria-labelledby="experience-heading">
      <h2 class="hk-h2 hk-block-heading" id="experience-heading">{site.about.experienceHeading}</h2>
      <ul class="hk-experience-grid">
        {
          data.experience.map((entry) => (
            <li class="hk-experience-card hk-card-sm">
              <h3 class="hk-experience-title">{entry.title}</h3>
              <p class="hk-experience-body">{entry.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hk-block" data-hk-reveal aria-labelledby="tools-heading">
      <h2 class="hk-h2 hk-block-heading is-tight" id="tools-heading">{site.about.toolsHeading}</h2>
      <ul class="hk-pill-row hk-tools">
        {data.tools.map((tool) => <li class="hk-pill hk-pill-lg">{tool}</li>)}
      </ul>
    </section>

    <section class="hk-block" data-hk-reveal aria-labelledby="timeline-heading">
      <h2 class="hk-h2 hk-block-heading" id="timeline-heading">{site.about.timelineHeading}</h2>
      <ol class="hk-timeline">
        {
          data.timeline.map((entry, index) => (
            <li class="hk-timeline-row" class:list={[entry.current && 'is-current']}>
              <span class="hk-timeline-rail" aria-hidden="true">
                <span class="hk-timeline-dot" />
                {index < data.timeline.length - 1 && <span class="hk-timeline-line" />}
              </span>
              <span
                class="hk-timeline-entry"
                class:list={[index === data.timeline.length - 1 && 'is-last']}
              >
                <span class="hk-timeline-period">{entry.period}</span>
                <span class="hk-timeline-role">{entry.role}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <ContactCta variant="band" />
  </div>
</Base>

<style>
  .hk-story {
    padding-bottom: 128px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .hk-story-prose {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* The opening line is set larger and in full-strength ink. */
  .hk-story-prose :global(p) {
    font-size: var(--hk-body);
    line-height: 1.55;
    color: var(--hk-ink-2);
    text-wrap: pretty;
  }

  .hk-story-prose :global(p:first-child) {
    font-size: var(--hk-lead);
    line-height: 1.45;
    color: var(--hk-ink);
  }

  .hk-portrait {
    border-radius: var(--hk-r-card);
    overflow: hidden;
    background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline);
    height: 520px;
    position: relative;
  }

  .hk-portrait :global(img),
  .hk-portrait :global(.hk-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--hk-media-filter);
  }

  /* --- Shared block spacing ----------------------------------------- */

  .hk-block {
    padding-bottom: 128px;
  }

  .hk-block-heading {
    margin-bottom: 56px;
  }

  .hk-block-heading.is-tight {
    margin-bottom: 48px;
  }

  /* --- Experience ---------------------------------------------------- */

  .hk-experience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hk-gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hk-experience-card {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hk-experience-title {
    font-size: var(--hk-h3-sm);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hk-experience-body {
    font-size: var(--hk-body-sm);
    line-height: 1.5;
    color: var(--hk-ink-2);
  }

  /* --- Tools --------------------------------------------------------- */

  .hk-tools {
    max-width: 820px;
    gap: 10px;
  }

  /* --- Timeline ------------------------------------------------------ */

  .hk-timeline {
    display: flex;
    flex-direction: column;
    max-width: 720px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hk-timeline-row {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--hk-gap-sm);
  }

  .hk-timeline-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hk-timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: var(--hk-r-pill);
    background: var(--hk-surface);
    border: 1px solid var(--hk-hairline-3);
    margin-top: 6px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .is-current .hk-timeline-dot {
    background: var(--hk-accent);
    border-color: var(--hk-accent);
  }

  .hk-timeline-line {
    width: 1px;
    flex: 1;
    background: var(--hk-hairline-2);
  }

  .hk-timeline-entry {
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hk-timeline-entry.is-last {
    padding-bottom: 0;
  }

  .hk-timeline-period {
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--hk-ink-3-text);
  }

  .is-current .hk-timeline-period {
    color: var(--hk-accent-text);
  }

  .hk-timeline-role {
    font-size: var(--hk-body);
    font-weight: 700;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .hk-story {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-bottom: 80px;
    }

    .hk-portrait {
      height: auto;
      aspect-ratio: 4 / 5;
      order: -1;
    }

    .hk-block {
      padding-bottom: 80px;
    }

    .hk-block-heading {
      margin-bottom: 40px;
    }

    .hk-experience-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hk-experience-card {
      padding: 28px;
    }
  }
</style>
