---
import type { GetStaticPaths } from 'astro';
import site from '../../../data/site.json';
import Base from '../../../layouts/Base.astro';
import ArchiveIndex from '../../../components/ArchiveIndex.astro';
import { getArchiveItems, categorySlug, type ArchiveItem } from '../../../lib/content';
import { breadcrumbSchema, graph } from '../../../lib/schema';

interface Props {
  name: string;
  items: ArchiveItem[];
  allItems: ArchiveItem[];
}

/**
 * One page per category, so the filter chips are ordinary links that work
 * before any JavaScript runs. With JavaScript on, these pages are rarely
 * loaded — theme.ts filters in place instead — but they remain valid URLs
 * that can be shared, bookmarked and indexed.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getArchiveItems();
  return site.archive.categories
    .filter((name) => name !== site.archive.allLabel)
    .map((name) => ({
      params: { category: categorySlug(name) },
      props: {
        name,
        items: items.filter((item) => item.data.category === name),
        allItems: items,
      },
    }));
};

const { name, items, allItems } = Astro.props;
const slug = categorySlug(name);

const jsonLd = graph([
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: site.archive.heading, path: '/archive' },
    { name, path: `/archive/c/${slug}` },
  ]),
]);
---

<Base
  title={`${name} · ${site.archive.heading}`}
  description={`${name} — ${site.archive.description}`}
  jsonLd={jsonLd}
  active="/archive"
>
  <ArchiveIndex items={items} allItems={allItems} active={slug} />
</Base>
