---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';

const identityPills = [
  'Red-and-gold emblem',
  'White primary surface',
  'Bold product typography',
  'Distinctive colour accents',
  'Consistent food imagery',
  'Bilingual descriptions',
];

const k1 = {
  name: 'Classic',
  format: 'Cream cheese · Blue',
  img: '/media/drive/11TvQ6sEVoOGri9kYoQynBQohHjEg9mlz.jpg',
  alt: 'KERI Classic — Cream cheese · Blue packaging',
};
const k2 = {
  name: 'Garlic & Dill',
  format: 'Cream cheese · Green',
  img: '/media/drive/169Q7QyLeTk997LLCaJkLPm2aBSzh7mGC.jpg',
  alt: 'KERI Garlic & Dill — Cream cheese · Green packaging',
};
const k3 = {
  name: 'Classic',
  format: 'Processed cheese · Orange',
  img: '/media/drive/1Ae5ZWN0gV3QVWOfsihfdudLWZOobyBwD.jpg',
  alt: 'KERI Classic — Processed cheese · Orange packaging',
};
const k4 = {
  name: 'Boletus Mushrooms',
  format: 'Processed cheese · Brown',
  img: '/media/drive/1uD_NXERFekkntYpAzwwTVLDMc0sJgyib.jpg',
  alt: 'KERI Boletus Mushrooms — Processed cheese · Brown packaging',
};

const systemPacks = [k1, k3];
const variants = [k1, k2, k3, k4];
---

<BaseLayout
  title="Archive — KERI | Hristo Karakerezov"
  description="A cohesive packaging system for a range of cream and processed cheeses."
  active="archive"
>
  <div class="hk-shell">

    <section class="hero">
      <a href="/archive/" class="back-link"><span aria-hidden="true">&larr;</span>Archive</a>
      <div class="tag-row">
        <span class="tag tag-active">Dairy</span>
        <span class="tag">Food Packaging</span>
        <span class="tag">Visual Identity</span>
      </div>
      <h1>KERI</h1>
      <p class="lead">A cohesive packaging system for a range of cream and processed cheeses.</p>
    </section>

    <section class="main-visual" data-hk-reveal>
      <div class="media-well">
        <span class="media-label" aria-hidden="true">KERI — product range</span>
        <img src="/media/drive/1BtvkVSMuWhrpud-e9yafP-T5WyKgsyil.png" alt="KERI cheese packaging range — hero" />
      </div>
    </section>

    <section class="meta" data-hk-reveal>
      <div class="meta-grid">
        <div class="meta-item"><span class="meta-label">Client</span><span class="meta-value">KERI</span></div>
        <div class="meta-item"><span class="meta-label">Category</span><span class="meta-value">Food Packaging / Visual Identity</span></div>
        <div class="meta-item"><span class="meta-label">Product</span><span class="meta-value">Cream cheese &amp; processed cheese</span></div>
        <div class="meta-item"><span class="meta-label">Range</span><span class="meta-value">Four variations, 165 g</span></div>
      </div>
    </section>

    <section class="project" data-hk-reveal>
      <h2>The Project</h2>
      <div class="project-copy">
        <p class="lead-sm">KERI is a dairy brand offering a range of cream and processed cheeses.</p>
        <p class="muted">The packaging design brings different product varieties together through a consistent visual structure, combining clear typography, distinctive colours and appetising food imagery.</p>
      </div>
    </section>

    <section class="identity" data-hk-reveal>
      <h2>A Consistent Visual Language</h2>
      <div class="identity-copy">
        <p class="ink">The packaging combines a prominent red-and-gold brand emblem with clean white surfaces and colour-coded product information.</p>
        <p class="muted">A consistent typographic hierarchy makes the product type easy to identify, while ingredient imagery and individual colour treatments distinguish each variety.</p>
        <div class="pill-row">
          {identityPills.map((p) => <span class="pill">{p}</span>)}
        </div>
      </div>
    </section>

    <section class="packaging-system">
      <div class="ps-head" data-hk-reveal>
        <h2>One Design System, Two Product Categories</h2>
        <div class="ps-copy">
          <p class="ink">The visual structure connects cream cheese and processed cheese under one recognisable packaging system.</p>
          <p class="muted">The brand emblem, product name, serving imagery and information panels maintain a consistent relationship, while typography and colour distinguish the two product categories.</p>
        </div>
      </div>
      <div class="ps-grid" data-hk-reveal>
        {systemPacks.map((p) => (
          <figure class="gallery-figure">
            <a href={p.img} data-hk-lightbox aria-label={`View ${p.name} larger`} class="gallery-link gallery-link-white">
              <img src={p.img} alt={p.alt} loading="lazy" />
              <span class="zoom-badge" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
              </span>
            </a>
            <figcaption class="caption-stack"><span class="pack-name">{p.name}</span><span class="pack-format">{p.format}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="variations">
      <div class="var-head" data-hk-reveal>
        <h2>Colour-Coded Product Varieties</h2>
        <p class="muted">Each product variation has its own colour identity, allowing customers to distinguish flavours and product types while recognising the KERI brand.</p>
      </div>
      <div class="var-grid" data-hk-reveal>
        {variants.map((p) => (
          <figure class="gallery-figure">
            <a href={p.img} data-hk-lightbox aria-label={`View ${p.name} larger`} class="gallery-link gallery-link-white">
              <img src={p.img} alt={p.alt} loading="lazy" />
              <span class="zoom-badge" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
              </span>
            </a>
            <figcaption class="caption-stack"><span class="pack-name">{p.name}</span><span class="pack-format">{p.format}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="nav-row" data-hk-reveal>
      <div class="nav-inner">
        <a href="/archive/karmela/" class="nav-prev"><span aria-hidden="true">&larr;</span>Karmela</a>
        <a href="/archive/" class="nav-back">Back to Archive</a>
        <span class="nav-next">Memo &mdash; coming soon</span>
      </div>
    </section>

    <section id="contact" class="contact-section" data-hk-reveal>
      <ContactCTA
        layout="row-single"
        heading="Let&rsquo;s connect."
        body="Open to UX/UI, product design and AI experience design opportunities."
        ctaLabel="Get in touch"
        ctaHref="/contact/"
      />
    </section>

  </div>
</BaseLayout>

<style>
  .hk-shell { padding-top: var(--hk-header-h); }

  .ink { color: var(--hk-ink); }
  .muted { color: var(--hk-ink-2); }

  section > h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em; margin: 0;
  }

  /* Hero */
  .hero { padding: 176px 0 56px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink-2); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .tag {
    display: inline-flex; font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-2);
    background: var(--hk-pill-fill); border: 1px solid var(--hk-hairline-2); border-radius: var(--hk-r-pill); padding: 7px 15px;
  }
  .tag-active { color: #00757F; background: var(--hk-accent-soft); border: none; padding: 8px 16px; }
  .hero h1 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h1-page);
    line-height: 1; letter-spacing: -0.03em; margin: 28px 0 0;
  }
  .hero .lead { margin: 28px 0 0; font-size: 22px; line-height: 1.45; color: var(--hk-ink-2); max-width: 680px; text-wrap: pretty; }

  /* Main visual */
  .main-visual { padding: 0 0 40px; }
  .media-well {
    border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline); min-height: 320px; position: relative;
  }
  .media-label {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 600; color: var(--hk-ink-3);
  }
  .media-well img { position: relative; width: 100%; height: auto; display: block; }

  /* Meta */
  .meta { padding: 0 0 128px; }
  .meta-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px;
    padding: 32px 8px 0; border-top: 1px solid var(--hk-hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 10px; }
  .meta-label { font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); text-transform: uppercase; letter-spacing: 0.06em; }
  .meta-value { font-size: 15px; line-height: 1.5; font-weight: 600; }

  /* The Project */
  .project { padding: 0 0 128px; display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 64px; align-items: start; }
  .project-copy { display: flex; flex-direction: column; gap: 24px; max-width: 720px; }
  .project-copy .lead-sm { margin: 8px 0 0; font-size: 22px; line-height: 1.45; color: var(--hk-ink); text-wrap: pretty; }
  .project-copy .muted { margin: 0; font-size: 18px; line-height: 1.55; text-wrap: pretty; }

  /* Visual identity */
  .identity { padding: 0 0 128px; display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 64px; align-items: start; }
  .identity-copy { display: flex; flex-direction: column; gap: 24px; max-width: 720px; }
  .identity-copy p { margin: 0; font-size: 18px; line-height: 1.55; text-wrap: pretty; }
  .identity-copy p.ink { margin-top: 8px; }
  .pill-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .pill {
    display: inline-flex; font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-2);
    background: rgba(255,255,255,0.6); border: 1px solid var(--hk-hairline-2); border-radius: var(--hk-r-pill); padding: 9px 16px;
  }

  /* Gallery figures (shared) */
  .gallery-figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .gallery-link {
    display: block; width: 100%; padding: 0; margin: 0; cursor: zoom-in; border-radius: var(--hk-r-media);
    overflow: hidden; border: 1px solid var(--hk-hairline); position: relative; transition: var(--hk-t-card);
  }
  .gallery-link-white { background: var(--hk-surface); }
  .gallery-link:hover { transform: var(--hk-lift); box-shadow: var(--hk-card-shadow); }
  .gallery-link img { position: relative; width: 100%; height: auto; display: block; }
  .zoom-badge {
    position: absolute; right: 14px; bottom: 14px; width: 36px; height: 36px; border-radius: var(--hk-r-pill);
    background: var(--hk-badge); border: 1px solid var(--hk-hairline); display: flex; align-items: center; justify-content: center;
  }
  .caption-stack { display: flex; flex-direction: column; gap: 6px; padding: 0 8px; }
  .pack-name { font-size: 15px; font-weight: 700; line-height: 1.2; }
  .pack-format { font-size: 13px; font-weight: 600; color: var(--hk-ink-3-text); }

  /* Packaging system */
  .packaging-system { padding: 0 0 128px; }
  .ps-head { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 64px; align-items: start; margin-bottom: 56px; }
  .ps-copy { display: flex; flex-direction: column; gap: 20px; max-width: 720px; }
  .ps-copy p { margin: 0; font-size: 18px; line-height: 1.55; text-wrap: pretty; }
  .ps-copy p.ink { margin-top: 8px; }
  .ps-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }

  /* Product variations */
  .variations { padding: 0 0 128px; }
  .var-head { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 64px; align-items: start; margin-bottom: 56px; }
  .var-head p { margin: 8px 0 0; font-size: 18px; line-height: 1.55; max-width: 720px; text-wrap: pretty; }
  .var-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; align-items: start; }

  /* Prev/next navigation row */
  .nav-row { padding: 0 0 96px; }
  .nav-inner { border-top: 1px solid var(--hk-hairline); padding-top: 56px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px; }
  .nav-prev { justify-self: start; display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink); }
  .nav-back {
    display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink);
    background: transparent; border: 1px solid var(--hk-hairline-3); border-radius: var(--hk-r-pill); padding: 14px 24px;
    transition: background .25s ease;
  }
  .nav-back:hover { background: var(--hk-hover-tint); color: var(--hk-ink); }
  .nav-next { justify-self: end; display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink-3); }

  .contact-section { padding: 0 0 96px; }

  @media (max-width: 900px) {
    .project, .identity, .ps-head, .var-head { grid-template-columns: 1fr; gap: 32px; }
    .ps-grid { grid-template-columns: 1fr; }
    .var-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nav-inner { grid-template-columns: 1fr; gap: 20px; text-align: center; }
    .nav-prev, .nav-back, .nav-next { justify-self: center; }
  }
  @media (max-width: 600px) {
    .var-grid { grid-template-columns: 1fr; }
  }
</style>
