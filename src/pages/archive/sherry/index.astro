---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';

const identity = {
  src: '/media/drive/1of3wZGjaFdPwHNFITToRho1NEpiAkWQt.png',
  alt: 'Sherry gold ribbon logo',
};

const labels = [
  { src: '/media/drive/1pU8pngI_AlsRTcVXqxELjlNCLbbu24Hp.jpg', name: 'Sour Cream & Raspberry', alt: 'Sherry Sour Cream & Raspberry — label artwork' },
  { src: '/media/drive/1cLPq0ZqX_SVIzry7PSk6EjmeP6zOiOhd.jpg', name: 'Blueberry', alt: 'Sherry Blueberry — label artwork' },
  { src: '/media/drive/1VSEzNaxOFHFF685lKyQlinK7SzjPtZCU.jpg', name: 'Chocolate, Almond & Honey', alt: 'Sherry Chocolate, Almond & Honey — label artwork' },
  { src: '/media/drive/1ng9pCZyHphKe4U4zaow8dkDKSUc61P7G.jpg', name: 'Cheesecake', alt: 'Sherry Cheesecake — label artwork' },
];

const products = [
  { src: '/media/drive/1KMByQiPNxkqUTP8VQx84pWa91W-FYsFj.jpg', name: 'Raspberry', alt: 'Sherry raspberry ice cream packaging composition' },
  { src: '/media/drive/1GmYtLIaOIq6y8EP2jmJUAcpwcsEbSt0J.jpg', name: 'Chocolate, Almond & Honey', alt: 'Sherry chocolate, almond and honey ice cream packaging composition' },
  { src: '/media/drive/1aTl_pIGmRRDqPRoryUEwvsTFmkbX4SOg.jpg', name: 'Blueberry', alt: 'Sherry blueberry ice cream packaging composition' },
  { src: '/media/drive/1NPYM2uO1sc6cAxbRQJo917jU3hygVFvY.gif', name: 'Product composition', alt: 'Sherry ice cream packaging composition' },
];
---

<BaseLayout
  title="Archive — Sherry | Hristo Karakerezov"
  description="Sherry — a distinctive visual identity and packaging system for an ice cream brand, designed by Hristo Karakerezov."
  active="archive"
>
  <div class="hk-shell">

    <section class="hero">
      <a href="/archive/" class="back-link"><span aria-hidden="true">&larr;</span>Archive</a>
      <div class="tag-row">
        <span class="pill pill-accent">Ice Cream</span>
        <span class="pill">Brand Identity</span>
        <span class="pill">Packaging Design</span>
      </div>
      <h1>Sherry</h1>
      <p class="lead">A distinctive visual identity and packaging system for an ice cream brand.</p>
    </section>

    <section class="main-visual" data-hk-reveal>
      <div class="media-frame">
        <span class="media-placeholder" aria-hidden="true">Sherry — raspberry flavour packaging</span>
        <img src="/media/drive/1bduldySt_vuMRg0JPsOUfWCniJp1BrWn.png" alt="Sherry ice cream packaging — hero" />
      </div>
    </section>

    <section class="meta-section" data-hk-reveal>
      <div class="meta-grid">
        <div class="meta-item">
          <span class="meta-label">Client</span>
          <span class="meta-value">Sherry</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Role</span>
          <span class="meta-value">Brand Identity &amp; Packaging Designer</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Scope</span>
          <span class="meta-value">Logo Design, Visual Identity, Packaging, Brand Applications</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Industry</span>
          <span class="meta-value">Food &amp; Beverage</span>
        </div>
      </div>
    </section>

    <section class="project-section" data-hk-reveal>
      <h2>The Project</h2>
      <div class="project-copy">
        <p class="project-lead">Sherry is an ice cream brand inspired by the appeal of homemade recipes and distinctive flavours.</p>
        <p class="muted">The project involved developing the brand identity and a cohesive packaging system that brings together expressive typography, rich colour and appetising product imagery.</p>
        <p class="muted">The visual approach combines a recognisable brand signature with individual flavour identities, creating consistency across the range without sacrificing variety.</p>
      </div>
    </section>

    <section class="identity-section" data-hk-reveal>
      <div class="identity-grid">
        <div class="identity-copy">
          <span class="eyebrow">Brand Identity</span>
          <h2>A Distinctive Brand Character</h2>
          <p class="ink">The Sherry identity is built around a flowing gold script logotype that brings warmth and personality to the brand.</p>
          <p class="muted">Combined with dark packaging surfaces, refined gold detailing and vivid flavour colours, the identity creates a recognisable visual character across different products and applications.</p>
          <div class="tag-row identity-pill-row">
            <span class="pill pill-soft">Gold script logotype</span>
            <span class="pill pill-soft">Black &amp; gold</span>
            <span class="pill pill-soft">Flavour-specific colour</span>
          </div>
        </div>
        <a href={identity.src} data-hk-lightbox aria-label="View Gold ribbon logo larger" class="identity-frame">
          <img src={identity.src} alt={identity.alt} loading="lazy" />
        </a>
      </div>
    </section>

    <section class="packaging-section">
      <div class="packaging-head" data-hk-reveal>
        <h2>One Identity, Multiple Flavours</h2>
        <div class="project-copy">
          <p class="ink">The packaging system follows a consistent visual structure, keeping the Sherry logotype, product information and overall composition familiar across the range.</p>
          <p class="muted">Each flavour receives its own colour treatment and ingredient imagery, making the products easy to distinguish while preserving a unified brand appearance.</p>
        </div>
      </div>
      <div class="label-grid" data-hk-reveal>
        {labels.map((l) => (
          <figure class="gallery-figure">
            <a href={l.src} data-hk-lightbox aria-label={`View ${l.name} larger`} class="label-thumb">
              <span class="media-placeholder" aria-hidden="true">{l.name}</span>
              <img src={l.src} alt={l.alt} loading="lazy" />
              <span class="gallery-corner" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
              </span>
            </a>
            <figcaption class="gallery-caption">{l.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="product-section">
      <div class="packaging-head" data-hk-reveal>
        <h2>Flavours in Focus</h2>
        <div class="project-copy">
          <p class="ink">The product compositions extend the packaging identity through expressive colour, ingredient imagery and carefully balanced arrangements.</p>
          <p class="muted">Each visual reinforces the character of its flavour while maintaining the distinctive Sherry packaging as the central element.</p>
        </div>
      </div>
      <div class="product-grid" data-hk-reveal>
        {products.map((p) => (
          <figure class="gallery-figure">
            <a href={p.src} data-hk-lightbox aria-label={`View ${p.name} larger`} class="product-thumb">
              <span class="media-placeholder" aria-hidden="true">{p.name}</span>
              <img src={p.src} alt={p.alt} loading="lazy" />
              <span class="gallery-corner" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
              </span>
            </a>
            <figcaption class="gallery-caption">{p.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="applications-section" data-hk-reveal>
      <div class="applications-head">
        <h2>Beyond the Packaging</h2>
        <p class="muted">The visual identity extends into supporting brand materials, maintaining consistency through the Sherry logotype, restrained colour palette and distinctive graphic character.</p>
      </div>
      <div class="applications-card">
        <figure class="card-figure">
          <img src="/media/drive/1kisGJd2j71eAbyg25F2XGC53yKfUPvu-.png" alt="Sherry business card — front" loading="lazy" />
          <figcaption class="card-caption">Business card</figcaption>
        </figure>
        <figure class="card-figure">
          <img src="/media/drive/1yzUWMfPiPFwQlu9tWrwOxra2SZSjsxSx.jpg" alt="Sherry business card — back" loading="lazy" />
          <figcaption class="card-caption">Business card, reverse</figcaption>
        </figure>
      </div>
    </section>

    <section class="nav-section" data-hk-reveal>
      <div class="nav-row">
        <a href="/archive/ahat/" class="nav-link nav-link-start"><span aria-hidden="true">&larr;</span>AHAT</a>
        <a href="/archive/" class="nav-pill">Back to Archive</a>
        <a href="/archive/karmela/" class="nav-link nav-link-end">Karmela<span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <section id="contact" class="contact-section" data-hk-reveal>
      <ContactCTA layout="row-single" />
    </section>

  </div>
</BaseLayout>

<style>
  .hk-shell { padding-top: var(--hk-header-h); }

  .hero { padding: 176px 0 56px; }
  .back-link {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta);
    font-weight: 600; line-height: 1; color: var(--hk-ink-2);
  }
  .back-link:hover { color: var(--hk-accent); }

  .tag-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .pill {
    display: inline-flex; font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1;
    color: var(--hk-ink-2); background: var(--hk-pill-fill); border: 1px solid var(--hk-hairline-2);
    border-radius: var(--hk-r-pill); padding: 7px 15px;
  }
  .pill-accent { color: #00757F; background: var(--hk-accent-soft); border: none; padding: 8px 16px; }
  .pill-soft { background: rgba(255,255,255,0.6); padding: 9px 16px; }

  .hero h1 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h1-page);
    line-height: 1; letter-spacing: -0.03em; margin: 28px 0 0;
  }
  .hero .lead { margin: 28px 0 0; font-size: var(--hk-lead); line-height: 1.45; color: var(--hk-ink-2); max-width: 680px; text-wrap: pretty; }

  .main-visual { padding: 0 0 40px; }
  .media-frame {
    border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline); min-height: 320px; position: relative;
  }
  .media-placeholder {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding: 16px; text-align: center; font-size: var(--hk-meta-sm); font-weight: 600; color: var(--hk-ink-3);
  }
  .media-frame img { position: relative; width: 100%; height: auto; display: block; }

  .meta-section { padding: 0 0 128px; }
  .meta-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px;
    padding: 32px 8px 0; border-top: 1px solid var(--hk-hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 10px; }
  .meta-label { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); text-transform: uppercase; letter-spacing: 0.06em; }
  .meta-value { font-size: var(--hk-meta); line-height: 1.5; font-weight: 600; }

  .project-section {
    padding: 0 0 128px; display: grid; grid-template-columns: minmax(0,320px) minmax(0,1fr);
    gap: 64px; align-items: start;
  }
  .project-section > h2, .identity-copy h2, .packaging-head h2, .product-section .packaging-head h2, .applications-head h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2); line-height: 1.05; letter-spacing: -0.02em; margin: 0;
  }
  .project-copy { display: flex; flex-direction: column; gap: 24px; max-width: 720px; }
  .project-lead { margin: 8px 0 0; font-size: var(--hk-lead); line-height: 1.45; text-wrap: pretty; }
  .project-copy p.muted, .applications-head p.muted { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }
  .project-copy p.ink { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink); text-wrap: pretty; }

  .identity-section { padding: 0 0 128px; }
  .identity-grid { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); gap: 64px; align-items: center; }
  .identity-copy { display: flex; flex-direction: column; gap: 20px; max-width: 520px; }
  .eyebrow { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: #00757F; text-transform: uppercase; letter-spacing: 0.06em; }
  .identity-copy p.ink { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink); text-wrap: pretty; }
  .identity-copy p.muted { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }
  .identity-pill-row { margin-top: 4px; }

  .identity-frame {
    display: block; width: 100%; border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); aspect-ratio: 8/9; position: relative; cursor: zoom-in;
  }
  .identity-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

  .packaging-section, .product-section { padding: 0 0 128px; }
  .packaging-head { display: grid; grid-template-columns: minmax(0,320px) minmax(0,1fr); gap: 64px; align-items: start; margin-bottom: 56px; }
  .packaging-head .project-copy p.ink { margin: 8px 0 0; }

  .label-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 24px; }
  .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24px; align-items: start; }

  .gallery-figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .gallery-caption { font-size: var(--hk-meta); font-weight: 700; line-height: 1.2; padding: 0 8px; }

  .label-thumb {
    display: block; width: 100%; border-radius: var(--hk-r-card-sm); overflow: hidden; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); min-height: 200px; position: relative; cursor: zoom-in;
    transition: var(--hk-t-card);
  }
  .label-thumb:hover { transform: var(--hk-lift); box-shadow: var(--hk-card-shadow); }
  .label-thumb img { position: relative; width: 100%; height: auto; max-height: 640px; object-fit: contain; display: block; }

  .product-thumb {
    display: block; width: 100%; border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline); min-height: 280px; position: relative; cursor: zoom-in;
    transition: var(--hk-t-card);
  }
  .product-thumb:hover { transform: var(--hk-lift); box-shadow: var(--hk-card-shadow); }
  .product-thumb img { position: relative; width: 100%; height: auto; display: block; }

  .gallery-corner {
    position: absolute; right: 14px; bottom: 14px; width: 36px; height: 36px; border-radius: var(--hk-r-pill);
    background: var(--hk-badge); border: 1px solid var(--hk-hairline); display: flex; align-items: center; justify-content: center;
  }

  .applications-section { padding: 0 0 128px; }
  .applications-head { display: grid; grid-template-columns: minmax(0,320px) minmax(0,1fr); gap: 64px; align-items: start; margin-bottom: 40px; }
  .applications-head p.muted { max-width: 720px; }
  .applications-card {
    background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card);
    padding: 56px; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px; align-items: center;
  }
  .card-figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .card-figure img {
    width: 100%; height: auto; display: block; border-radius: 12px;
    box-shadow: 0 1px 2px rgba(21,21,21,0.06), 0 16px 32px -20px rgba(21,21,21,0.25);
  }
  .card-caption { padding: 0 4px; font-size: var(--hk-meta); font-weight: 700; line-height: 1.2; }

  .nav-section { padding: 0 0 96px; }
  .nav-row {
    border-top: 1px solid var(--hk-hairline); padding-top: 56px; display: grid;
    grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px;
  }
  .nav-link { display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1; color: var(--hk-ink); }
  .nav-link-start { justify-self: start; }
  .nav-link-end { justify-self: end; }
  .nav-pill {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1;
    color: var(--hk-ink); background: transparent; border: 1px solid var(--hk-hairline-3); border-radius: var(--hk-r-pill);
    padding: 14px 24px; transition: background .25s ease;
  }
  .nav-pill:hover { background: var(--hk-hover-tint); color: var(--hk-ink); }

  .contact-section { padding: 0 0 96px; }

  @media (max-width: 900px) {
    .identity-grid, .project-section, .packaging-head, .applications-head { grid-template-columns: 1fr; }
    .label-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .product-grid, .applications-card { grid-template-columns: 1fr; }
    /* The fixed min-height values above were tuned for desktop column
       widths; at narrower widths the image's natural rendered height can
       fall short of them, leaving an empty strip below the image. */
    .media-frame, .label-thumb, .product-thumb { min-height: 0; }
  }
  @media (max-width: 600px) {
    .label-grid { grid-template-columns: 1fr; }
    .nav-row { grid-template-columns: 1fr; gap: 16px; text-align: center; }
    .nav-link-start, .nav-link-end { justify-self: center; }
  }
</style>
