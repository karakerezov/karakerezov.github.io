---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';

const logo = {
  src: '/media/drive/1RhyLCIC5DJ48KVcWCmJvfs2P3cHWS0oy.jpg',
  alt: 'Victoria Ice Tea logo',
};

const labels = [
  { src: '/media/drive/1a9Bk1IGgfvU46fh7VD2GhKEK7_vFBjmq.jpg', name: 'Lemon — 0.5 L label', format: '211 × 61 mm', alt: 'Victoria Ice Tea lemon label, 0.5 L, 211 × 61 mm' },
  { src: '/media/drive/102kbM4b5lKM4C0u3b-YvujpQrzg8E5ui.jpg', name: 'Lemon — 2 L label', format: '320 × 108 mm', alt: 'Victoria Ice Tea lemon label, 2 L, 320 × 108 mm' },
];

const flavours = [
  { src: '/media/drive/1BzdgLWZS3tFshKrIXjB3T5ensml_GyX5.jpg', name: 'Lemon', format: 'Yellow', alt: 'Victoria Ice Tea lemon' },
  { src: '/media/drive/18fQUNf_9qLrZZxlkyPyhFAUrDT7QrPhe.jpg', name: 'Peach', format: 'Orange', alt: 'Victoria Ice Tea peach' },
  { src: '/media/drive/19yq8WbJSilpShNpDtJrnCauEfsGPtvEP.jpg', name: 'Forest Fruit', format: 'Pink & red', alt: 'Victoria Ice Tea forest fruit' },
];

const vitrina = {
  src: '/media/drive/1iRhauKQbuKFL6xp_CCnxb_yzEPDE1t7X.jpg',
  alt: 'Victoria Ice Tea branded refrigerated display',
};
---

<BaseLayout
  title="Archive — Victoria Ice Tea | Hristo Karakerezov"
  description="Victoria Ice Tea — a distinctive packaging system for a sugar-free iced tea range, designed by Hristo Karakerezov."
  active="archive"
>
  <div class="hk-shell">

    <section class="hero">
      <a href="/archive/" class="back-link"><span aria-hidden="true">&larr;</span>Archive</a>
      <div class="tag-row">
        <span class="pill pill-accent">Drinks</span>
        <span class="pill">Beverage Packaging</span>
        <span class="pill">Visual Identity</span>
        <span class="pill">Retail Branding</span>
      </div>
      <h1>Victoria <span class="h1-italic">Ice Tea</span></h1>
      <p class="lead">A distinctive packaging system for a sugar-free iced tea range.</p>
    </section>

    <section class="main-visual" data-hk-reveal>
      <div class="media-frame">
        <span class="media-placeholder" aria-hidden="true">Victoria Ice Tea — full range</span>
        <img src="/media/drive/1xXqAOCGaBJp9tpULYbspMHMWn3TMT0Ea.png" alt="Victoria Ice Tea — hero" />
      </div>
    </section>

    <section class="meta-section" data-hk-reveal>
      <div class="meta-grid">
        <div class="meta-item">
          <span class="meta-label">Category</span>
          <span class="meta-value">Beverage Packaging / Visual Identity / Retail Branding</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Product</span>
          <span class="meta-value">Sugar-free iced tea</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Range</span>
          <span class="meta-value">Lemon, Peach, Forest Fruit</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Formats</span>
          <span class="meta-value">0.5 L and 2 L</span>
        </div>
      </div>
    </section>

    <section class="project-section" data-hk-reveal>
      <h2>The Project</h2>
      <div class="project-copy">
        <p class="project-lead">Victoria Ice Tea is a range of sugar-free iced teas available in three flavours and two bottle sizes.</p>
        <p class="muted">The packaging combines a distinctive brand signature, a dark visual foundation and vibrant flavour-specific graphics to establish a recognisable identity across the product range.</p>
      </div>
    </section>

    <section class="identity-section" data-hk-reveal>
      <div class="identity-grid">
        <div class="identity-copy">
          <span class="eyebrow">Visual Identity</span>
          <h2>A Fresh Take on Contrast</h2>
          <p class="ink">The Victoria identity brings together expressive script lettering and a clean, high-contrast packaging design.</p>
          <p class="muted">A prominent white logotype stands against the dark label, while green accents introduce a fresh visual character. Bold typography and colourful fruit-inspired graphics make the individual flavours easy to distinguish.</p>
        </div>
        <a href={logo.src} data-hk-lightbox aria-label="View Logo larger" class="logo-frame">
          <img src={logo.src} alt={logo.alt} loading="lazy" />
        </a>
      </div>
    </section>

    <section class="packaging-section">
      <div class="packaging-head" data-hk-reveal>
        <h2>One Identity, Two Formats</h2>
        <div class="project-copy">
          <p class="ink">The label system was developed for both 0.5-litre and 2-litre bottles, maintaining a consistent relationship between the logotype, flavour identification and product information.</p>
          <p class="muted">The dark background establishes visual continuity, while bright colour panels distinguish the flavours without disrupting the overall identity.</p>
        </div>
      </div>
      <div class="label-list" data-hk-reveal>
        {labels.map((l) => (
          <figure class="gallery-figure">
            <a href={l.src} data-hk-lightbox aria-label={`View ${l.name} larger`} class="label-thumb">
              <img src={l.src} alt={l.alt} loading="lazy" />
              <span class="gallery-corner" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
              </span>
            </a>
            <figcaption class="gallery-caption-row">
              <span class="gallery-name">{l.name}</span>
              <span class="gallery-format">{l.format}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="flavour-section">
      <div class="packaging-head" data-hk-reveal>
        <h2>Three Flavours, One Visual Language</h2>
        <div class="project-copy">
          <p class="ink">The flavour range uses a shared graphic structure with distinct colour treatments.</p>
          <p class="muted">Lemon is identified through vibrant yellow, Peach through warm orange, and Forest Fruit through rich pink and red tones.</p>
          <p class="muted">Together, the three variations form a cohesive and easily recognisable product family.</p>
        </div>
      </div>
      <div class="flavour-grid" data-hk-reveal>
        {flavours.map((f) => (
          <figure class="gallery-figure">
            <a href={f.src} data-hk-lightbox aria-label={`View ${f.name} larger`} class="label-thumb">
              <img src={f.src} alt={f.alt} loading="lazy" />
              <span class="gallery-corner" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
              </span>
            </a>
            <figcaption class="gallery-caption-row">
              <span class="gallery-name">{f.name}</span>
              <span class="gallery-format">{f.format}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="retail-section" data-hk-reveal>
      <div class="retail-grid">
        <a href={vitrina.src} data-hk-lightbox aria-label="View Refrigerated display larger" class="retail-frame">
          <img src={vitrina.src} alt={vitrina.alt} loading="lazy" />
        </a>
        <div class="identity-copy">
          <span class="eyebrow">Retail Branding</span>
          <h2>Extending the Identity into Retail</h2>
          <p class="ink">The Victoria visual identity extends beyond the bottle through branded refrigerated display equipment.</p>
          <p class="muted">The retail graphics combine the product, logotype and dark visual background with bright accents, creating a consistent presentation across packaging and point-of-sale materials.</p>
        </div>
      </div>
    </section>

    <section class="nav-section" data-hk-reveal>
      <div class="nav-row">
        <a href="/archive/keri/" class="nav-link nav-link-start"><span aria-hidden="true">&larr;</span>KERI</a>
        <a href="/archive/" class="nav-pill">Back to Archive</a>
        <span class="nav-memo nav-link-end">Memo — coming soon</span>
      </div>
    </section>

    <section id="contact" class="contact-section" data-hk-reveal>
      <ContactCTA layout="row-single" />
    </section>

  </div>
</BaseLayout>

<style>
  .hk-shell { padding-top: var(--hk-header-h); }

  .hero { padding: 176px 0 56px; }
  .back-link {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta);
    font-weight: 600; line-height: 1; color: var(--hk-ink-2);
  }
  .back-link:hover { color: var(--hk-accent); }

  .tag-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .pill {
    display: inline-flex; font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1;
    color: var(--hk-ink-2); background: var(--hk-pill-fill); border: 1px solid var(--hk-hairline-2);
    border-radius: var(--hk-r-pill); padding: 7px 15px;
  }
  .pill-accent { color: #00757F; background: var(--hk-accent-soft); border: none; padding: 8px 16px; }

  .hero h1 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h1-page);
    line-height: 1; letter-spacing: -0.03em; margin: 28px 0 0;
  }
  .h1-italic { font-style: italic; color: var(--hk-ink-2); }
  .hero .lead { margin: 28px 0 0; font-size: var(--hk-lead); line-height: 1.45; color: var(--hk-ink-2); max-width: 680px; text-wrap: pretty; }

  .main-visual { padding: 0 0 40px; }
  .media-frame {
    border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline); min-height: 320px; position: relative;
  }
  .media-placeholder {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding: 16px; text-align: center; font-size: var(--hk-meta-sm); font-weight: 600; color: var(--hk-ink-3);
  }
  .media-frame img { position: relative; width: 100%; height: auto; display: block; }

  .meta-section { padding: 0 0 128px; }
  .meta-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px;
    padding: 32px 8px 0; border-top: 1px solid var(--hk-hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 10px; }
  .meta-label { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); text-transform: uppercase; letter-spacing: 0.06em; }
  .meta-value { font-size: var(--hk-meta); line-height: 1.5; font-weight: 600; }

  .project-section {
    padding: 0 0 128px; display: grid; grid-template-columns: minmax(0,320px) minmax(0,1fr);
    gap: 64px; align-items: start;
  }
  .project-section > h2, .identity-copy h2, .packaging-head h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2); line-height: 1.05; letter-spacing: -0.02em; margin: 0;
  }
  .project-copy { display: flex; flex-direction: column; gap: 24px; max-width: 720px; }
  .project-lead { margin: 8px 0 0; font-size: var(--hk-lead); line-height: 1.45; text-wrap: pretty; }
  .project-copy p.muted { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }
  .project-copy p.ink { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink); text-wrap: pretty; }
  .packaging-head .project-copy p.ink { margin: 8px 0 0; }

  .identity-section { padding: 0 0 128px; }
  .identity-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.2fr); gap: 64px; align-items: center; }
  .identity-copy { display: flex; flex-direction: column; gap: 20px; max-width: 520px; }
  .eyebrow { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: #00757F; text-transform: uppercase; letter-spacing: 0.06em; }
  .identity-copy p.ink { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink); text-wrap: pretty; }
  .identity-copy p.muted { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }

  .logo-frame {
    display: flex; align-items: center; justify-content: center; width: 100%; padding: 40px;
    border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); min-height: 320px; position: relative; cursor: zoom-in;
  }
  .logo-frame img { position: relative; max-width: 100%; max-height: 480px; width: auto; height: auto; display: block; }

  .packaging-section, .flavour-section { padding: 0 0 128px; }
  .packaging-head { display: grid; grid-template-columns: minmax(0,320px) minmax(0,1fr); gap: 64px; align-items: start; margin-bottom: 56px; }

  .label-list { display: flex; flex-direction: column; gap: 40px; }
  .flavour-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 24px; align-items: start; }

  .gallery-figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .gallery-caption-row { display: flex; justify-content: space-between; gap: 12px; padding: 0 8px; }
  .gallery-name { font-size: var(--hk-meta); font-weight: 700; line-height: 1.2; }
  .gallery-format { font-size: var(--hk-meta-sm); font-weight: 600; color: var(--hk-ink-3-text); }

  .label-thumb {
    display: block; width: 100%; border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); position: relative; cursor: zoom-in; transition: var(--hk-t-card);
  }
  .label-thumb:hover { transform: var(--hk-lift); box-shadow: var(--hk-card-shadow); }
  .label-thumb img { position: relative; width: 100%; height: auto; display: block; }

  .gallery-corner {
    position: absolute; right: 14px; bottom: 14px; width: 36px; height: 36px; border-radius: var(--hk-r-pill);
    background: var(--hk-badge); border: 1px solid var(--hk-hairline); display: flex; align-items: center; justify-content: center;
  }

  .retail-section { padding: 0 0 128px; }
  .retail-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 64px; align-items: center; }
  .retail-frame {
    display: block; width: 100%; border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); position: relative; cursor: zoom-in;
  }
  .retail-frame img { position: relative; width: 100%; height: auto; display: block; }

  .nav-section { padding: 0 0 96px; }
  .nav-row {
    border-top: 1px solid var(--hk-hairline); padding-top: 56px; display: grid;
    grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px;
  }
  .nav-link { display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1; color: var(--hk-ink); }
  .nav-link-start { justify-self: start; }
  .nav-link-end { justify-self: end; }
  .nav-memo { display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); }
  .nav-pill {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1;
    color: var(--hk-ink); background: transparent; border: 1px solid var(--hk-hairline-3); border-radius: var(--hk-r-pill);
    padding: 14px 24px; transition: background .25s ease;
  }
  .nav-pill:hover { background: var(--hk-hover-tint); color: var(--hk-ink); }

  .contact-section { padding: 0 0 96px; }

  @media (max-width: 900px) {
    .identity-grid, .project-section, .packaging-head, .retail-grid { grid-template-columns: 1fr; }
    .flavour-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media (max-width: 600px) {
    .flavour-grid { grid-template-columns: 1fr; }
    .nav-row { grid-template-columns: 1fr; gap: 16px; text-align: center; }
    .nav-link-start, .nav-link-end { justify-self: center; }
  }
</style>
