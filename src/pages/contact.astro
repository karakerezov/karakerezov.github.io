---
import site from '../data/site.json';
import Base from '../layouts/Base.astro';
import ContactBody from '../components/ContactBody.astro';
import { contactPageSchema, breadcrumbSchema, graph } from '../lib/schema';

const jsonLd = graph([
  contactPageSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: site.contact.heading, path: '/contact' },
  ]),
]);
---

<Base
  title={site.contact.heading}
  description={site.contact.description}
  jsonLd={jsonLd}
  active="/contact"
>
  <ContactBody state="form" />
</Base>
