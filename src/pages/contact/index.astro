---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, LINKEDIN_URL } from '../../data/nav';
---

<BaseLayout
  title="Contact | Hristo Karakerezov"
  description="Get in touch with Hristo Karakerezov about UX/UI, product design and AI experience design opportunities."
  active="contact"
>
  <div class="hk-shell">

    <section class="intro">
      <h1>Contact</h1>
      <p class="lead">Good projects usually start with a conversation. Tell me what you&rsquo;re working on.</p>
    </section>

    <section class="contact-body" data-hk-reveal>

      <div class="contact-copy">
        <div class="contact-heading">
          <h2>Let&rsquo;s connect.</h2>
          <p class="ink">Whether it&rsquo;s a product idea, a design challenge, or a conversation about UX and AI, I&rsquo;d be happy to hear from you.</p>
          <p class="muted">No complicated brief required — a few words are a good start.</p>
        </div>
        <div class="contact-methods">
          <a class="contact-method" href={`mailto:${CONTACT_EMAIL}`}>
            <span class="method-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#00757F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
            <span class="method-text"><span class="method-label">Email</span><span class="method-value">{CONTACT_EMAIL}</span></span>
          </a>
          <a class="contact-method" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile (opens in a new tab)">
            <span class="method-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#00757F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-3a2 2 0 0 1 4 0v3"></path></svg></span>
            <span class="method-text"><span class="method-label">LinkedIn</span><span class="method-value">LinkedIn profile</span></span>
            <span class="method-arrow" aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>

      <div class="contact-form-card">
        <form id="cf-form" data-endpoint="https://formspree.io/f/mkjopgjw" novalidate>
          <div class="cf-honeypot" aria-hidden="true">
            <label for="cf-gotcha">Company</label>
            <input id="cf-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <div class="cf-group">
            <label for="cf-name">Name</label>
            <input id="cf-name" class="cf-field" type="text" name="name" autocomplete="name" placeholder="Your name" required aria-invalid="false" aria-describedby="cf-name-err" />
            <span id="cf-name-err" class="cf-error"></span>
          </div>
          <div class="cf-group">
            <label for="cf-email">Email</label>
            <input id="cf-email" class="cf-field" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required aria-invalid="false" aria-describedby="cf-email-err" />
            <span id="cf-email-err" class="cf-error"></span>
          </div>
          <div class="cf-group">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" class="cf-field" name="message" placeholder="Tell me a little about what you have in mind..." required aria-invalid="false" aria-describedby="cf-message-err"></textarea>
            <span id="cf-message-err" class="cf-error"></span>
          </div>
          <div class="cf-actions">
            <button type="submit" id="cf-submit">Send Message &rarr;</button>
          </div>
          <div id="cf-status" role="status" aria-live="polite"></div>
        </form>
        <p class="cf-alt">Prefer email? You can also reach me directly at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
      </div>

    </section>

  </div>
</BaseLayout>

<script src="/scripts/contact-form.js" defer></script>

<style>
  .hk-shell { padding-top: var(--hk-header-h); }
  .intro { padding: 176px 0 64px; }
  .intro h1 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h1-page);
    line-height: 1; letter-spacing: -0.03em;
  }
  .intro .lead { margin-top: 28px; font-size: 22px; line-height: 1.45; color: var(--hk-ink-2); max-width: 640px; }

  .contact-body {
    padding: 0 0 128px; display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 48px 64px; align-items: start;
  }
  .contact-copy { display: flex; flex-direction: column; gap: 32px; max-width: 520px; padding-top: 48px; }
  .contact-heading { display: flex; flex-direction: column; gap: 16px; }
  .contact-heading h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .contact-heading p { font-size: 18px; line-height: 1.6; }
  .contact-heading p.ink { color: var(--hk-ink); }
  .contact-heading p.muted { color: var(--hk-ink-2); }

  .contact-methods { display: flex; flex-direction: column; gap: 12px; }
  .contact-method {
    display: flex; align-items: center; gap: 16px; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); border-radius: 28px; padding: 16px 22px; color: var(--hk-ink);
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
  }
  .contact-method:hover { transform: translateY(-2px); box-shadow: 0 24px 44px -36px rgba(21,21,21,0.25); border-color: rgba(0,144,158,0.32); color: var(--hk-ink); }
  .method-icon { width: 40px; height: 40px; border-radius: 999px; background: var(--hk-accent-soft); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .method-text { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .method-label { font-size: 13px; font-weight: 600; line-height: 1; color: #6B6B65; }
  .method-value { font-size: 16px; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
  .method-arrow { margin-left: auto; font-size: 15px; color: #6B6B65; }

  .contact-form-card {
    background: var(--hk-surface); border: 1px solid var(--hk-hairline);
    border-radius: var(--hk-r-card); padding: clamp(28px, 4vw, 48px);
  }
  #cf-form { display: flex; flex-direction: column; gap: 22px; }
  .cf-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .cf-group { display: flex; flex-direction: column; gap: 10px; }
  .cf-group label { font-size: 14px; font-weight: 600; line-height: 1; color: var(--hk-ink); padding-left: 6px; }
  .cf-field {
    font-family: inherit; font-size: 16px; color: var(--hk-ink); background: var(--hk-surface);
    border: 1px solid var(--hk-hairline-3); border-radius: 28px; padding: 0 22px; height: 56px;
    outline: none; transition: border-color .2s ease, box-shadow .2s ease; width: 100%; box-sizing: border-box;
  }
  .cf-field::placeholder { color: #85857F; }
  .cf-field:focus { border-color: var(--hk-accent); box-shadow: 0 0 0 4px var(--hk-accent-soft); }
  .cf-field[aria-invalid="true"] { border-color: #B3261E; }
  .cf-field[aria-invalid="true"]:focus { box-shadow: 0 0 0 4px rgba(179,38,30,0.12); }
  textarea.cf-field { height: auto; min-height: 176px; padding: 18px 22px; resize: vertical; line-height: 1.55; }
  .cf-error { min-height: 0; font-size: 14px; line-height: 1.4; color: #B3261E; padding-left: 6px; }
  .cf-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  #cf-submit {
    font-family: inherit; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
    gap: 8px; min-height: 52px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-bg);
    background: var(--hk-ink); border: 1px solid var(--hk-ink); border-radius: var(--hk-r-pill); padding: 0 28px;
    transition: background .25s ease, border-color .25s ease, opacity .25s ease;
  }
  #cf-submit:hover { background: #00757F; border-color: #00757F; }
  #cf-submit[disabled] { opacity: 0.7; cursor: progress; }
  :global(.cf-status-ok) {
    margin: 0; display: flex; gap: 12px; align-items: flex-start; font-size: 15px; line-height: 1.5;
    color: var(--hk-ink); background: var(--hk-accent-soft); border-radius: 20px; padding: 16px 18px;
  }
  :global(.cf-status-err) {
    margin: 0; font-size: 15px; line-height: 1.5; color: var(--hk-ink);
    background: rgba(179,38,30,0.07); border-radius: 20px; padding: 16px 18px;
  }
  .cf-alt { margin: 28px 0 0; font-size: 15px; line-height: 1.5; color: var(--hk-ink-2); border-top: 1px solid var(--hk-hairline); padding-top: 24px; }
  .cf-alt a { color: #00757F; font-weight: 700; }
</style>
