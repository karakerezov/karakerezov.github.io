---
import site from '../../data/site.json';
import Base from '../../layouts/Base.astro';
import ContactBody from '../../components/ContactBody.astro';

/**
 * Where /api/contact sends people after a message goes out. A real page, so
 * the confirmation survives a reload and needs no JavaScript.
 */
---

<Base
  title={site.contact.successHeading}
  description={site.contact.successBody}
  active="/contact"
  noindex
>
  <ContactBody state="sent" />
</Base>
