---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import site from '../../data/site.json';
import CaseStudy from '../../layouts/CaseStudy.astro';
import Section from '../../components/casestudy/Section.astro';
import MetaBar from '../../components/casestudy/MetaBar.astro';
import Media from '../../components/Media.astro';
import { getProjects, neighbours, type Project } from '../../lib/content';
import { creativeWorkSchema, breadcrumbSchema, graph } from '../../lib/schema';

interface Props {
  project: Project;
  pair: { prev: Project; next: Project } | null;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, pair: neighbours(projects, index) },
  }));
};

const { project, pair } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const href = (id: string): string => `/work/${id}`;
const prev = pair ? { href: href(pair.prev.id), title: pair.prev.data.title } : undefined;
const next = pair ? { href: href(pair.next.id), title: pair.next.data.title } : undefined;

const meta = [
  { label: 'Role', value: data.role },
  { label: 'Timeline', value: data.timeline },
  { label: 'Team', value: data.team },
  { label: 'Platform', value: data.platform },
];

const jsonLd = graph([
  creativeWorkSchema({
    name: data.title,
    description: data.summaryIndex || data.summary,
    path: href(project.id),
    image: data.cover || undefined,
    keywords: data.tags,
    genre: data.subtitle,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: site.work.heading, path: '/work' },
    { name: data.title, path: href(project.id) },
  ]),
]);
---

<CaseStudy project={project} prev={prev} next={next} jsonLd={jsonLd} draft={data.draft}>
  {
    data.hero === 'standard' && (
      <>
        <section class="hk-cs-standard-hero">
          <p class="hk-cs-badge">{data.subtitle}</p>
          <h1 class="hk-h1-page hk-cs-standard-title">{data.title}</h1>
          <p class="hk-lead hk-cs-standard-lead">{data.summaryIndex || data.summary}</p>
          <MetaBar items={meta} />
        </section>

        <Section space="sm" top="24px">
          <div class="hk-cs-preview hk-card">
            <div class="hk-cs-preview-well">
              <Media
                src={data.cover}
                alt={data.coverAlt}
                sizes="(max-width: 900px) 92vw, 1280px"
                widths={[600, 1000, 1400]}
                eager
              />
            </div>
          </div>
        </Section>
      </>
    )
  }

  {
    /*
    `is-prose` styles headings and paragraphs written straight into a project
    file. A study that draws its own sections (hero: "custom") opts out, so
    these rules cannot reach inside its components.
  */
  }
  <div class="hk-cs-body" class:list={[data.hero === 'standard' && 'is-prose']}>
    <Content />
  </div>
</CaseStudy>

<style>
  .hk-cs-standard-hero {
    padding: var(--hk-page-top) 0 72px;
    max-width: 980px;
  }

  .hk-cs-badge {
    display: inline-flex;
    font-size: var(--hk-meta-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--hk-accent-text);
    background: var(--hk-accent-soft);
    border-radius: var(--hk-r-pill);
    padding: 8px 16px;
  }

  .hk-cs-standard-title {
    margin-top: 28px;
  }

  .hk-cs-standard-lead {
    margin-top: 32px;
    max-width: var(--hk-prose-max);
  }

  .hk-cs-preview {
    padding: var(--hk-gap-sm);
  }

  .hk-cs-preview-well {
    border-radius: var(--hk-r-media);
    overflow: hidden;
    background: var(--hk-surface-alt);
    height: 560px;
    position: relative;
  }

  .hk-cs-preview-well :global(img),
  .hk-cs-preview-well :global(.hk-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--hk-media-filter);
  }

  /* Markdown written straight into a project file, with no components. */
  .hk-cs-body.is-prose :global(h2) {
    font-family: var(--hk-font-display);
    font-weight: 400;
    font-size: var(--hk-h2);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 64px 0 24px;
    max-width: var(--hk-content-max);
  }

  .hk-cs-body.is-prose :global(h3) {
    font-size: var(--hk-h3-sm);
    font-weight: 700;
    line-height: 1.2;
    margin: 40px 0 16px;
  }

  .hk-cs-body.is-prose :global(p) {
    font-size: var(--hk-body);
    line-height: 1.55;
    color: var(--hk-ink-2);
    max-width: var(--hk-content-max);
    margin-bottom: 20px;
    text-wrap: pretty;
  }

  .hk-cs-body.is-prose :global(ul),
  .hk-cs-body.is-prose :global(ol) {
    max-width: var(--hk-content-max);
    color: var(--hk-ink-2);
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .hk-cs-body.is-prose :global(li) {
    margin-bottom: 8px;
  }

  .hk-cs-body.is-prose :global(a) {
    color: var(--hk-accent-text);
    font-weight: 600;
  }

  .hk-cs-body.is-prose :global(blockquote) {
    background: var(--hk-accent-soft);
    border-radius: var(--hk-r-media);
    padding: 32px 40px;
    margin: 32px 0;
    max-width: var(--hk-content-max);
  }

  @media (max-width: 900px) {
    .hk-cs-standard-hero {
      padding-bottom: 48px;
    }
    .hk-cs-preview-well {
      height: auto;
      aspect-ratio: 16 / 10;
    }
    .hk-cs-body.is-prose :global(h2) {
      margin-top: 48px;
    }
  }
</style>
