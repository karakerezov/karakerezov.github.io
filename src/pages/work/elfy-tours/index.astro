---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
---

<BaseLayout
  title="Elfy Tours Case Study | Hristo Karakerezov"
  description="Web and mobile travel experience design for Elfy Tours — a responsive homepage bringing together destination inspiration, travel offers and an easy-to-find search entry point."
  active="work"
>
  <div class="hk-shell">

    <section class="hero">
      <a href="/work/" class="breadcrumb"><span aria-hidden="true">&larr;</span>Recent Work</a>
      <div class="hero-tags">
        <span class="tag-pill tag-pill-accent">Travel Brand</span>
        <span class="tag-pill tag-pill-outline">UI Design</span>
        <span class="tag-pill tag-pill-outline">Web &amp; Mobile</span>
      </div>
      <h1 class="hero-title">Elfy Tours</h1>
      <p class="hero-lead">Web &amp; mobile travel experience design for an inspiring travel brand.</p>
    </section>

    <section class="hero-visual" data-hk-reveal>
      <div class="media-cover">
        <img src="/media/drive/1ywcPTPjkUlWHL0sIWqMsaHNzboF-AgFo.png" alt="Elfy Tours — web and mobile travel interface" loading="lazy" />
      </div>
    </section>

    <section class="meta-section" data-hk-reveal>
      <dl class="meta-grid">
        <div class="meta-item">
          <dt>Client</dt>
          <dd>Elfy Tours</dd>
        </div>
        <div class="meta-item">
          <dt>Role</dt>
          <dd>UI Designer / Visual Designer</dd>
        </div>
        <div class="meta-item">
          <dt>Platform</dt>
          <dd>Web &amp; Mobile</dd>
        </div>
        <div class="meta-item">
          <dt>Deliverables</dt>
          <dd>Homepage design — desktop + mobile</dd>
        </div>
        <div class="meta-item">
          <dt>Focus</dt>
          <dd>Travel landing page, offer browsing, destination discovery, responsive UI</dd>
        </div>
        <div class="meta-item">
          <dt>Tools</dt>
          <dd>Photoshop, Illustrator, Figma</dd>
        </div>
      </dl>
    </section>

    <section class="brief" data-hk-reveal>
      <h2>The Brief</h2>
      <div class="brief-body">
        <p class="brief-lead">Elfy Tours is a travel brand offering curated journeys to distinctive destinations. The brief was to design a responsive homepage that brings together destination inspiration, travel offers and an easy-to-find search entry point.</p>
        <p class="brief-sub">The challenge was to make exploration feel exciting while keeping practical trip-planning actions immediately accessible.</p>
        <ol class="brief-points">
          <li><span class="point-num">01</span><span class="point-label">Inspire exploration</span></li>
          <li><span class="point-num">02</span><span class="point-label">Simplify travel discovery</span></li>
          <li><span class="point-num">03</span><span class="point-label">Maintain clarity across devices</span></li>
        </ol>
      </div>
    </section>

    <section class="design-direction" data-hk-reveal>
      <div class="logo-panel">
        <img src="/media/drive/1cOiBQk54WFE7IrkmG1OgxRdpTcPz3k2u.jpg" alt="Elfy Tours logo" loading="lazy" />
      </div>
      <div class="direction-panel">
        <h2>Design Direction</h2>
        <p>The visual direction combines immersive destination photography, vibrant colour and a distinctive use of diagonal section transitions.</p>
        <p>Instead of conventional horizontal boundaries, angled edges connect successive homepage sections, creating a sense of movement, momentum and visual continuity. This dynamic rhythm reflects the experience of travelling from one destination to another.</p>
        <p>The result is an expressive travel-inspired interface that maintains a clear content hierarchy and keeps essential actions easy to find.</p>
      </div>
    </section>

    <section class="desktop-experience">
      <div class="section-intro" data-hk-reveal>
        <h2>Desktop Experience</h2>
        <p>A homepage designed to move naturally from inspiration to action — starting with search, then introducing offers, trust signals, destinations, and thematic exploration.</p>
      </div>

      <div class="sub-block sub-block-stacked" data-hk-reveal>
        <div class="sub-head sub-head-md">
          <span class="kicker">01 / Search &amp; Discovery</span>
          <h3>Inspiration meets search</h3>
          <p>Immersive destination imagery sets the emotional tone, balanced by a prominent search bar at the centre of the first screen — giving visitors a clear, accessible starting point for planning a trip.</p>
        </div>
        <div class="media-wide media-ratio-slider">
          <img src="/media/drive/19-tcNHrJGHrfGtS86qxlsT7UDdBmmEwx.jpg" alt="Elfy Tours — Slider &amp; search — desktop" loading="lazy" />
        </div>
      </div>

      <div class="sub-block sub-block-offers" data-hk-reveal>
        <div class="sub-head sub-head-sm">
          <span class="kicker">02 / Offer Exploration</span>
          <h3>Offers at a glance</h3>
          <p>Offers follow one consistent card structure — image, destination, essential trip details and actions — so visitors can compare options without relearning how each one works.</p>
        </div>
        <a href="/media/drive/1OnkdBQyjk62OhE5PS3Diq6aekZsbLLsh.png" data-hk-lightbox class="media-wide media-zoomable media-ratio-offers" aria-label="View Top offers — desktop larger">
          <img src="/media/drive/1OnkdBQyjk62OhE5PS3Diq6aekZsbLLsh.png" alt="Elfy Tours — Top offers — desktop" loading="lazy" />
        </a>
      </div>

      <div class="sub-block sub-block-trust">
        <div class="sub-head sub-head-md" data-hk-reveal>
          <span class="kicker">03 / Trust &amp; Exploration</span>
          <h3>Confidence to explore</h3>
          <p>Credibility signals and visual destination discovery work together, supporting both reassurance and exploration.</p>
        </div>

        <figure class="trust-figure" data-hk-reveal>
          <div class="media-wide media-ratio-trust">
            <img src="/media/drive/1I4FKECIjANKEDGuShrCTEz96LpVHiJn3.jpg" alt="Elfy Tours — Why trust us — statistics band" loading="lazy" />
          </div>
          <figcaption class="trust-caption">
            <span class="caption-title">Why Trust Us</span>
            <span class="caption-body">A prominent statistics section introduces the company&rsquo;s experience and scale through information that can be understood at a glance.</span>
          </figcaption>
        </figure>

        <figure class="dest-figure" data-hk-reveal>
          <a href="/media/drive/1X_xveDhq1ClXTtEPgJKEJAAWT2ruM-Sk.jpg" data-hk-lightbox class="media-wide media-zoomable media-ratio-dest" aria-label="View Destinations carousel — desktop larger">
            <img src="/media/drive/1X_xveDhq1ClXTtEPgJKEJAAWT2ruM-Sk.jpg" alt="Elfy Tours — Destinations carousel — desktop" loading="lazy" />
          </a>
          <figcaption class="dest-caption">
            <span class="caption-title">Destinations</span>
            <span class="caption-body">Image-led destination cards encourage exploratory browsing, giving visitors another way to discover travel opportunities before choosing a specific offer.</span>
          </figcaption>
        </figure>
      </div>

      <div class="sub-block sub-block-stacked" data-hk-reveal>
        <div class="sub-head sub-head-md">
          <span class="kicker">04 / Interest-Based Discovery</span>
          <h3>Explore by travel style</h3>
          <p>Travel categories provide an alternative to destination-based searching. Visitors can begin with the kind of experience they want, even when they have not yet decided where to go.</p>
        </div>
        <div class="media-wide media-ratio-categories">
          <img src="/media/drive/18zzfb0u795LwZUvKq63NZpH0m0ZmShA7.jpg" alt="Elfy Tours — Themed travel categories — desktop" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="mobile-experience">
      <div class="section-intro" data-hk-reveal>
        <h2>Mobile Experience</h2>
        <p>The mobile experience adapts the desktop homepage into a focused vertical journey. Search, travel offers, destinations and service information are arranged for comfortable browsing and interaction on smaller screens.</p>
      </div>

      <div class="mobile-row mobile-row-copy-first" data-hk-reveal>
        <div class="mobile-copy">
          <span class="kicker">Mobile / 01</span>
          <h3>Search First</h3>
          <p>On mobile, search remains a priority at the beginning of the journey. The desktop search bar becomes a compact, touch-friendly vertical form, keeping destination, dates and traveller selection clear and accessible.</p>
        </div>
        <div class="mobile-media">
          <img src="/media/drive/1NGM-0_mmrgCOiDQphYCfkwG8OcsB7yeB.png" alt="Elfy Tours — Search first — iPhone 15 mockup" loading="lazy" />
        </div>
      </div>

      <div class="mobile-row mobile-row-media-first" data-hk-reveal>
        <div class="mobile-media">
          <img src="/media/drive/1sKiDpVJMPSdNduWkvNQQF2eikjlwSnOx.png" alt="Elfy Tours — Offers &amp; trust — iPhone 16 mockup" loading="lazy" />
        </div>
        <div class="mobile-copy">
          <span class="kicker">Mobile / 02</span>
          <h3>Offers &amp; Trust</h3>
          <p>Travel offers are reorganised into compact, image-led cards that keep essential trip details and actions easy to scan. Trust information remains accessible, supporting comparison and confidence without interrupting the browsing experience.</p>
        </div>
      </div>

      <div class="mobile-row mobile-row-copy-first" data-hk-reveal>
        <div class="mobile-copy">
          <span class="kicker">Mobile / 03</span>
          <h3>Destination Discovery</h3>
          <p>Destination imagery plays a central role in the mobile experience. Large visuals and focused navigation encourage exploration, while the simplified content hierarchy helps users consider one destination at a time.</p>
        </div>
        <div class="mobile-media">
          <img src="/media/drive/1-FJVGvGAWeEyJeCuVfmzFp8eE6uLb4UJ.png" alt="Elfy Tours — Destination discovery — iPhone 16 Pro mockup" loading="lazy" />
        </div>
      </div>

      <div class="mobile-row mobile-row-media-first" data-hk-reveal>
        <div class="mobile-media">
          <img src="/media/drive/1H6-zjcwezQ6rfhCVdkMvAWGuUpKlysiu.png" alt="Elfy Tours — Navigation &amp; service — iPhone 15 Pro mockup" loading="lazy" />
        </div>
        <div class="mobile-copy">
          <span class="kicker">Mobile / 04</span>
          <h3>Navigation &amp; Service</h3>
          <p>The mobile interface keeps navigation and contact options easily accessible while maintaining a clean, focused layout. A dedicated service section uses recognisable icons and concise labels to help users access practical information.</p>
        </div>
      </div>
    </section>

    <section class="takeaways" data-hk-reveal>
      <h2>Design Takeaways</h2>
      <div class="takeaways-body">
        <p class="takeaways-lead">Elfy Tours explores the balance between visual inspiration and functional clarity. Immersive destination photography and diagonal transitions between homepage sections create a distinctive sense of movement, while structured search, offers and destination categories support practical browsing.</p>
        <p class="takeaways-sub">The mobile adaptation preserves this visual identity through a simpler, vertically prioritised experience, keeping discovery engaging and essential interactions accessible.</p>
      </div>
    </section>

    <section class="case-nav" data-hk-reveal>
      <a href="/work/display-daily/" class="case-nav-link"><span aria-hidden="true">&larr;</span>Display Daily</a>
      <a href="/work/" class="case-nav-pill">Back to Recent Work</a>
      <a href="/work/grovia/" class="case-nav-link">Grovia<span aria-hidden="true">&rarr;</span></a>
    </section>

    <section id="contact" class="contact-section" data-hk-reveal>
      <ContactCTA layout="row-single" />
    </section>

  </div>
</BaseLayout>

<style>
  .hero { padding: 176px 0 56px; }
  .breadcrumb {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1;
    color: var(--hk-ink-2);
  }
  .breadcrumb:hover { color: var(--hk-accent); }

  .hero-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .tag-pill { display: inline-flex; font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; border-radius: var(--hk-r-pill); }
  .tag-pill-accent { color: #00757F; background: var(--hk-accent-soft); padding: 8px 16px; }
  .tag-pill-outline { color: var(--hk-ink-2); background: var(--hk-pill-fill); border: 1px solid var(--hk-hairline-2); padding: 7px 15px; }

  .hero-title {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h1-page);
    line-height: 1; letter-spacing: -0.03em; margin: 28px 0 0;
  }
  .hero-lead { margin: 28px 0 0; font-size: var(--hk-lead); line-height: 1.45; color: var(--hk-ink-2); max-width: 680px; text-wrap: pretty; }

  .hero-visual { padding: 0 0 40px; }
  .media-cover {
    border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface-alt);
    border: 1px solid var(--hk-hairline); min-height: 320px;
  }
  .media-cover img { width: 100%; height: auto; display: block; }

  .meta-section { padding: 0 0 128px; }
  .meta-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px;
    margin: 0; padding: 32px 8px 0; border-top: 1px solid var(--hk-hairline);
  }
  .meta-item { display: flex; flex-direction: column; gap: 10px; }
  .meta-item dt {
    font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .meta-item dd { margin: 0; font-size: var(--hk-meta); line-height: 1.5; font-weight: 600; }

  .brief {
    padding: 0 0 128px; display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: 64px; align-items: start;
  }
  .brief h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .brief-body { display: flex; flex-direction: column; gap: 24px; max-width: var(--hk-prose-max); }
  .brief-lead { margin: 8px 0 0; font-size: var(--hk-lead); line-height: 1.45; text-wrap: pretty; }
  .brief-sub { margin: 0; font-size: var(--hk-body); line-height: 1.6; color: var(--hk-ink-2); text-wrap: pretty; }

  .brief-points {
    list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--hk-hairline);
  }
  .brief-points li { display: flex; flex-direction: column; gap: 10px; padding: 24px 24px 0 0; border-left: 1px solid transparent; }
  .brief-points li:not(:first-child) { padding-left: 24px; border-left: 1px solid var(--hk-hairline); }
  .point-num { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); }
  .point-label { font-size: 16px; font-weight: 700; line-height: 1.35; }

  .design-direction {
    padding: 0 0 160px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 24px; align-items: stretch;
  }
  .logo-panel {
    display: flex; align-items: center; justify-content: center; padding: 48px;
    border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface);
    border: 1px solid var(--hk-hairline); min-height: 360px;
  }
  .logo-panel img { max-width: 100%; max-height: 280px; width: auto; height: auto; object-fit: contain; display: block; }
  .direction-panel {
    background: var(--hk-surface-alt); border-radius: var(--hk-r-card); padding: 56px;
    display: flex; flex-direction: column; gap: 24px; justify-content: center;
  }
  .direction-panel h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .direction-panel p { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink); text-wrap: pretty; }

  .desktop-experience { padding: 0 0 160px; }
  .section-intro {
    display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 64px;
    align-items: start; margin-bottom: 96px;
  }
  .section-intro h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .section-intro p { margin: 8px 0 0; font-size: var(--hk-lead); line-height: 1.45; max-width: 720px; text-wrap: pretty; }

  .sub-block { display: flex; flex-direction: column; gap: 48px; }
  .sub-block-stacked { padding-bottom: 160px; }
  .sub-block-offers {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 40px;
    align-items: center; padding: 0 0 160px;
  }
  .sub-block-trust { padding: 0 0 160px; }

  .sub-head { display: flex; flex-direction: column; gap: 20px; }
  .sub-head-md { max-width: 620px; }
  .sub-head-sm { max-width: 400px; }
  .kicker { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: #00757F; text-transform: uppercase; letter-spacing: 0.06em; }
  .sub-head h3, .mobile-copy h3 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: 36px; line-height: 1.1; letter-spacing: -0.015em;
  }
  .sub-head p, .mobile-copy p { margin: 0; font-size: var(--hk-body); line-height: 1.6; color: var(--hk-ink-2); text-wrap: pretty; }

  .media-wide {
    display: block; width: 100%; border-radius: var(--hk-r-card-sm); overflow: hidden;
    background: var(--hk-surface-alt); border: 1px solid var(--hk-hairline); position: relative;
    box-shadow: 0 1px 2px rgba(21,21,21,0.04), 0 12px 32px -16px rgba(21,21,21,0.18);
  }
  .media-wide img { width: 100%; height: auto; display: block; }
  .media-zoomable { cursor: zoom-in; }
  .media-ratio-slider { aspect-ratio: 1440 / 380; }
  .media-ratio-offers { aspect-ratio: 1600 / 702; }
  .media-ratio-trust { aspect-ratio: 1440 / 280; }
  .media-ratio-dest { aspect-ratio: 1202 / 399; }
  .media-ratio-categories { aspect-ratio: 1440 / 705; }

  .trust-figure { margin: 0; display: flex; flex-direction: column; gap: 28px; }
  .trust-caption { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 40px; align-items: baseline; }
  .caption-title { font-size: var(--hk-body); font-weight: 700; line-height: 1.35; letter-spacing: -0.01em; }
  .caption-body { margin: 0; font-size: var(--hk-body); line-height: 1.6; color: var(--hk-ink-2); max-width: 620px; text-wrap: pretty; }

  .dest-figure {
    margin: 40px 0 0; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 40px; align-items: end;
  }
  .dest-caption { display: flex; flex-direction: column; gap: 12px; padding-bottom: 8px; max-width: 420px; }

  .mobile-experience { padding: 128px 0 96px; border-top: 1px solid var(--hk-hairline); }
  .mobile-row {
    display: grid; gap: 48px; align-items: center; padding: 64px 0;
  }
  .mobile-row:first-of-type { padding: 0 0 64px; }
  .mobile-row-copy-first { grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr); }
  .mobile-row-media-first { grid-template-columns: minmax(0, 2.6fr) minmax(0, 1fr); }
  .mobile-copy { display: flex; flex-direction: column; gap: 20px; max-width: 420px; }
  .mobile-media { display: flex; align-items: center; justify-content: center; width: 100%; }
  .mobile-media img { max-width: 100%; width: 100%; height: auto; display: block; }

  .takeaways {
    padding: 128px 0; display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: 64px; align-items: start; border-top: 1px solid var(--hk-hairline);
  }
  .takeaways h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em;
  }
  .takeaways-body { display: flex; flex-direction: column; gap: 24px; max-width: var(--hk-prose-max); padding-top: 8px; }
  .takeaways-lead { margin: 0; font-size: var(--hk-lead); line-height: 1.45; text-wrap: pretty; }
  .takeaways-sub { margin: 0; font-size: var(--hk-body); line-height: 1.6; color: var(--hk-ink-2); text-wrap: pretty; }

  .case-nav {
    padding: 0 0 96px 0; margin-top: 0;
  }
  .case-nav {
    display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
    border-top: 1px solid var(--hk-hairline); padding-top: 56px; padding-bottom: 96px;
  }
  .case-nav-link { display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1; color: var(--hk-ink); }
  .case-nav-link:hover { color: var(--hk-accent); }
  .case-nav-pill {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--hk-meta); font-weight: 600; line-height: 1;
    color: var(--hk-ink); background: transparent; border: 1px solid var(--hk-hairline-3); border-radius: var(--hk-r-pill);
    padding: 14px 24px; transition: background .25s ease;
  }
  .case-nav-pill:hover { background: var(--hk-hover-tint); color: var(--hk-ink); }

  .contact-section { padding: 0 0 96px; }

  @media (max-width: 900px) {
    /* .media-cover's fixed min-height was tuned for desktop column widths;
       at narrower widths the image's natural rendered height can fall
       short of it, leaving an empty strip below the image. .logo-panel is
       an intentional padded, centered logo showcase — left as is. */
    .media-cover { min-height: 0; }
    .design-direction { grid-template-columns: 1fr; }
    .brief { grid-template-columns: 1fr; gap: 32px; }
    .section-intro { grid-template-columns: 1fr; gap: 24px; margin-bottom: 64px; }
    .sub-block-offers { grid-template-columns: 1fr; }
    .trust-caption { grid-template-columns: 1fr; gap: 16px; }
    .dest-figure { grid-template-columns: 1fr; }
    .mobile-row-copy-first, .mobile-row-media-first { grid-template-columns: 1fr; }
    .mobile-row-media-first .mobile-media { order: -1; }
    .takeaways { grid-template-columns: 1fr; gap: 24px; }
    .brief-points { grid-template-columns: 1fr; }
    .brief-points li, .brief-points li:not(:first-child) { padding: 20px 0 0; border-left: none; border-top: 1px solid var(--hk-hairline); }
    .brief-points li:first-child { border-top: none; }
  }
</style>
