          <!-- 2 · Reusable labels -->
          <div class="ds-group">
            <span class="ds-label">Label component</span>
            <div class="ds-row">
              <div class="ds-item"><span class="ds-item-label">Red</span><img src="/assets/grovia-design-system/label-red.svg" width="61" height="24" alt="Red label" loading="lazy" /></div>
