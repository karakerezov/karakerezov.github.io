---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const journey = [
  { stage: 'Plan', action: 'Thinks about what the household needs this week.', thought: 'What are we out of again?', friction: 'Relies on memory.', opportunity: 'Surface previous lists.', emotion: 'Unsure', dot: '#F6BE45' },
  { stage: 'Search', action: 'Opens the app and searches product by product.', thought: 'I buy these every week.', friction: 'Repetitive typing.', opportunity: 'Reuse familiar orders.', emotion: 'Tedious', dot: '#C7264B' },
  { stage: 'Compare', action: 'Checks prices and offers across items.', thought: 'Is this actually a deal?', friction: 'Offers are easy to miss.', opportunity: 'Clearer price hierarchy.', emotion: 'Cautious', dot: '#F6BE45' },
  { stage: 'Add', action: 'Adds items one by one to the cart.', thought: 'Did I forget anything?', friction: 'No sense of completeness.', opportunity: 'List-based building.', emotion: 'Effortful', dot: '#C7264B' },
  { stage: 'Pay', action: 'Moves through checkout and payment.', thought: 'How many steps are left?', friction: 'Unclear progress.', opportunity: 'Visible step structure.', emotion: 'Tense', dot: '#F6BE45' },
  { stage: 'Wait', action: 'Waits for the order after paying.', thought: 'Where is my order now?', friction: 'No status after payment.', opportunity: 'Persistent tracking.', emotion: 'Anxious', dot: '#C7264B' },
];

const shopFlow = ['Home', 'Category', 'Products', 'Product Details', 'Cart', 'Delivery Details', 'Payment Method', 'Order Review', 'Order Confirmation', 'Delivery Tracking'];
const repeatFlow = ['Shopping History / Favorites', 'Select', 'Load Selected', 'Review Cart', 'Checkout'];

const lofiTasks = [
  { n: 1, label: 'Find a product' },
  { n: 2, label: 'Add it to favourites' },
  { n: 3, label: 'Add products to the cart' },
  { n: 4, label: 'Reuse a previous list' },
  { n: 5, label: 'Complete checkout' },
  { n: 6, label: 'Locate delivery information' },
];

const findings = [
  { tag: 'Finding 01 · Reusing a previous order', title: 'Reusing a previous order', quote: 'I found yesterday’s list, but I wasn’t sure how to put it back in my cart.', insight: 'The history screen showed past lists, but the next action was not sufficiently clear.', response: 'Added a clear selected state and a contextual “Load Selected List” action.' },
  { tag: 'Finding 02 · Checkout orientation', title: 'Checkout orientation', quote: 'I know I’m checking out, but how many steps are left?', insight: 'Users needed a stronger sense of progress during checkout.', response: 'Added a visible three-step checkout indicator.' },
  { tag: 'Finding 03 · Delivery visibility', title: 'Delivery visibility', quote: 'The order is confirmed. Where can I see what happens next?', insight: 'Confirmation alone did not provide enough reassurance.', response: 'Added the “Track Your Delivery” CTA and persistent delivery progress.' },
  { tag: 'Finding 04 · Promotion hierarchy', title: 'Promotion hierarchy', quote: 'I saw the price, but I almost missed that it was a special offer.', insight: 'Promotion labels and price differences needed stronger hierarchy.', response: 'Strengthened the Best Price badge, sale price, and contrast.' },
];

const evolution = [
  { before: 'Previous lists appeared as passive history records.', after: 'Radio-button selection and “Load to Cart” action clarify reuse.' },
  { before: 'Checkout screens felt disconnected.', after: 'A three-step progress indicator creates orientation.' },
  { before: 'Order confirmation ended the journey.', after: 'A clear tracking CTA continues the experience.' },
  { before: 'Promotional information competed with the rest of the card.', after: 'Colour, size, and placement strengthen the price hierarchy.' },
];

const deliveryPhases = ['Order Confirmed', 'Packed & Ready', 'On the Way', 'Delivered'];
const systemBits = ['Interactive buttons', 'Favourite toggle', 'Selected radio states', 'Quantity controls', 'Navigation active states', 'Checkout progress', 'Slide-in profile menu', 'Delivery status changes', 'Form interactions'];
---

<BaseLayout
  title="Grovia Case Study | Hristo Karakerezov"
  description="Grovia is a mobile grocery shopping experience designed around real shopping habits — discovery, repeat orders, checkout, and delivery tracking in one continuous flow."
  active="work"
>
  <div class="hk-shell">

    <!-- HERO IMAGE -->
    <section class="hero-visual" data-hk-reveal>
      <div class="media-cover">
        <img src="/hero/grovia-hero-new.png" alt="Grovia — grocery app hero" loading="eager" />
      </div>
    </section>

    <!-- HERO INTRO -->
    <section class="hero" data-hk-reveal>
      <div class="hero-heading">
        <span class="eyebrow">Mobile Grocery App &middot; UX/UI Case Study</span>
        <h1>Grovia</h1>
      </div>
      <div class="hero-intro-grid">
        <div class="hero-intro-left">
          <p class="lead">A smoother way to shop for everyday groceries.</p>
          <p class="sub">Grovia is a mobile grocery shopping experience designed around real shopping habits — discovering products, repeating familiar orders, completing checkout, and following delivery in one continuous flow.</p>
        </div>
        <div class="hero-intro-right">
          <div class="meta-grid">
            <div class="meta-item"><span class="meta-label">Role</span><span class="meta-value">UX/UI Designer</span></div>
            <div class="meta-item"><span class="meta-label">Scope</span><span class="meta-value">Research, UX Strategy, Wireframes, UI, Prototyping</span></div>
            <div class="meta-item"><span class="meta-label">Platform</span><span class="meta-value">Mobile Application</span></div>
            <div class="meta-item"><span class="meta-label">Tool</span><span class="meta-value">Figma</span></div>
          </div>
        </div>
      </div>
      <div class="cta-row">
        <a href="#top" class="btn-primary">View Interactive Prototype<span aria-hidden="true">&rarr;</span></a>
        <a href="#story" class="btn-ghost">Explore the process<span aria-hidden="true">&darr;</span></a>
      </div>
    </section>

    <!-- OPENING STORY -->
    <section id="story" class="story" data-hk-reveal>
      <div class="story-inner">
        <h2>Grocery shopping is repetitive. The experience should not be.</h2>
        <p class="sub">People often buy the same products week after week, yet many shopping apps make them search, select, and rebuild every order from the beginning. Grovia explores how a familiar household task can become faster, calmer, and easier to repeat.</p>
        <blockquote class="story-quote">
          <p>&ldquo;Less time rebuilding lists. More time for everyday life.&rdquo;</p>
        </blockquote>
      </div>
    </section>

    <!-- PROJECT OVERVIEW -->
    <section class="overview" data-hk-reveal>
      <div class="overview-copy">
        <h2>The project at a glance</h2>
        <p class="sub">Grovia combines product discovery, favourites, shopping history, checkout, loyalty rewards, profile management, and delivery tracking in one mobile experience.</p>
      </div>
      <div class="overview-cards">
        <div class="overview-card">
          <span class="card-label">Challenge</span>
          <p>Reduce repeated effort across everyday grocery shopping.</p>
        </div>
        <div class="overview-card">
          <span class="card-label">Primary users</span>
          <p>Busy, price-aware people who regularly repurchase familiar products.</p>
        </div>
        <div class="overview-card">
          <span class="card-label">Design objective</span>
          <p>Create a clear shopping flow that supports both discovery and repetition.</p>
        </div>
      </div>
    </section>

    <!-- THE CHALLENGE -->
    <section class="challenge" data-hk-reveal>
      <div class="challenge-intro">
        <h2>Familiar task. Repeated friction.</h2>
        <p class="sub">Buying groceries is routine, but the digital journey often includes unnecessary searching, repeated decisions, and uncertainty after checkout.</p>
      </div>
      <div class="challenge-grid">
        <div class="challenge-card">
          <span class="challenge-num">01</span>
          <h3>Rebuilding the same cart</h3>
          <p>Users repeatedly search for products they already purchase regularly.</p>
        </div>
        <div class="challenge-card">
          <span class="challenge-num">02</span>
          <h3>Remembering everything</h3>
          <p>Manual lists and memory increase the chance of forgotten items.</p>
        </div>
        <div class="challenge-card">
          <span class="challenge-num">03</span>
          <h3>Finding meaningful offers</h3>
          <p>Promotions are useful only when they are easy to notice and understand.</p>
        </div>
        <div class="challenge-card">
          <span class="challenge-num">04</span>
          <h3>Waiting without context</h3>
          <p>After payment, users want to know what is happening with their order.</p>
        </div>
      </div>
    </section>

    <!-- UNDERSTANDING THE USER -->
    <section class="research" data-hk-reveal>
      <div class="research-copy">
        <h2>Understanding the user</h2>
        <p class="lead-muted">Before designing screens, I looked at the routines behind them.</p>
        <div class="tag-row">
          <span class="tag">Short user interviews</span>
          <span class="tag">Behavioural assumptions</span>
          <span class="tag">Competitive review</span>
          <span class="tag">Task analysis</span>
        </div>
        <span class="note">Research simulation for a portfolio project — not verified real-world data.</span>
      </div>
      <div class="research-media">
        <img src="/media/embedded/gv-research.webp" alt="Lifestyle photo of hands holding a phone with a grocery list" loading="lazy" />
      </div>
    </section>

    <!-- RESEARCH INSIGHTS -->
    <section class="insights" data-hk-reveal>
      <h2>What the research suggested</h2>
      <div class="insights-grid">
        <div class="insight-card">
          <h3>Shopping is repetitive</h3>
          <p>Many users buy a similar group of products every week.</p>
        </div>
        <div class="insight-card">
          <h3>Memory is not a shopping tool</h3>
          <p>People forget items or rebuild lists from scratch.</p>
        </div>
        <div class="insight-card">
          <h3>Offers need context</h3>
          <p>A lower price matters only when it is visible and easy to compare.</p>
        </div>
        <div class="insight-card">
          <h3>Delivery creates uncertainty</h3>
          <p>After checkout, users want clear and timely progress information.</p>
        </div>
      </div>
    </section>

    <!-- PRIMARY PERSONA -->
    <section class="persona" data-hk-reveal>
      <div class="persona-card">
        <div class="persona-media">
          <img src="/media/embedded/gv-persona.webp" alt="Portrait of Elena, a friendly working parent persona" loading="lazy" />
        </div>
        <div class="persona-info">
          <div class="persona-head">
            <span class="card-label">Primary persona</span>
            <h3>Elena &middot; 38</h3>
            <span class="persona-sub">Marketing manager &middot; Household of four</span>
          </div>
          <blockquote class="persona-quote">
            <p>&ldquo;Most weeks I buy the same things. I shouldn&rsquo;t have to start from zero every time.&rdquo;</p>
          </blockquote>
          <div class="persona-grid">
            <div class="persona-field">
              <span class="field-label">Goals</span>
              <p>Shop for the household quickly, reuse familiar orders, and catch good-value offers.</p>
            </div>
            <div class="persona-field">
              <span class="field-label">Frustrations</span>
              <p>Rebuilding lists each week, forgetting items, and unclear delivery status.</p>
            </div>
            <div class="persona-field">
              <span class="field-label">Habits</span>
              <p>Shops once or twice a week on mobile and saves favourites.</p>
            </div>
            <div class="persona-field">
              <span class="field-label">Scenario</span>
              <p>Between meetings, she reorders the weekly basket and schedules an evening delivery.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- JOURNEY MAP -->
    <section class="journey" data-hk-reveal>
      <div class="journey-intro">
        <h2>Where the effort builds up</h2>
        <p class="sub">The journey showed that much of the friction happens before payment — while planning, remembering, searching, and rebuilding a familiar order.</p>
      </div>
      <div class="journey-scroll">
        <div class="journey-grid">
          {journey.map((s) => (
            <div class="journey-col">
              <div class="journey-stage-row">
                <span class="journey-dot" style={`background:${s.dot}`}></span>
                <span class="journey-stage">{s.stage}</span>
              </div>
              <div class="journey-divider"></div>
              <div class="journey-card">
                <span class="journey-label">Action</span>
                <span class="journey-text">{s.action}</span>
                <span class="journey-label">Thinking</span>
                <span class="journey-thought">&ldquo;{s.thought}&rdquo;</span>
                <span class="journey-label">Friction</span>
                <span class="journey-text">{s.friction}</span>
                <span class="journey-label journey-label--accent">Opportunity</span>
                <span class="journey-text journey-text--ink">{s.opportunity}</span>
              </div>
              <span class="journey-emotion" style={`color:${s.dot}`}>{s.emotion}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROBLEM STATEMENT -->
    <section class="problem" data-hk-reveal>
      <div class="problem-box">
        <p class="problem-text">A busy grocery shopper needs a faster way to <span class="highlight">rebuild recurring orders</span> because searching for the same products every week wastes time and increases the chance of <span class="highlight">forgetting something</span>.</p>
        <h2 class="problem-h2">How might we make repeat grocery shopping feel almost effortless?</h2>
      </div>
    </section>

    <!-- DESIGN PRINCIPLES -->
    <section class="principles" data-hk-reveal>
      <h2>Three principles, three interface decisions</h2>
      <div class="principles-grid">
        <div class="principle-col">
          <a href="/uploads/Product-Filters.png" data-hk-lightbox>
            <img class="principle-img" src="/uploads/Product-Filters.png" alt="Grovia product filters screen" loading="lazy" />
          </a>
          <div class="principle-text">
            <h3>Find faster</h3>
            <p>Clear categories, filters, promotions, and visual product cards reduce unnecessary searching.</p>
          </div>
        </div>
        <div class="principle-col">
          <a href="/history-ms31vn9e-0c35.png" data-hk-lightbox>
            <img class="principle-img" src="/history-ms31vn9e-0c35.png" alt="Grovia shopping history screen" loading="lazy" />
          </a>
          <div class="principle-text">
            <h3>Repeat easily</h3>
            <p>Favourites and previous shopping lists help users begin with something familiar instead of starting again.</p>
          </div>
        </div>
        <div class="principle-col">
          <a href="/uploads/Track-the-Delivery-Profile.png" data-hk-lightbox>
            <img class="principle-img" src="/uploads/Track-the-Delivery-Profile.png" alt="Grovia delivery tracking in profile" loading="lazy" />
          </a>
          <div class="principle-text">
            <h3>Stay informed</h3>
            <p>Order confirmation and delivery tracking reduce uncertainty after payment.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- INFORMATION ARCHITECTURE -->
    <section class="ia" data-hk-reveal>
      <div class="ia-intro">
        <h2>A structure built around shopping habits</h2>
        <p class="sub">Frequent actions stay within reach in the bottom navigation, while personal settings and support tools remain inside the profile area.</p>
      </div>
      <div class="ia-card">
        <span class="ia-badge">Grovia</span>
        <div class="ia-divider"></div>
        <div class="ia-nav-block">
          <span class="card-label">Primary navigation</span>
          <div class="ia-pill-row">
            <span class="ia-pill">Home</span>
            <span class="ia-pill">Favourites</span>
            <span class="ia-pill">Shop</span>
            <span class="ia-pill">History</span>
            <span class="ia-pill">Cart</span>
          </div>
        </div>
        <div class="ia-split">
          <div class="ia-col">
            <span class="card-label">Account area</span>
            <div class="ia-outline-row">
              <span class="ia-outline-pill">Profile</span>
              <span class="ia-outline-pill">Addresses</span>
              <span class="ia-outline-pill">Billing</span>
              <span class="ia-outline-pill">Payment Methods</span>
              <span class="ia-outline-pill">Settings</span>
              <span class="ia-outline-pill">Accessibility</span>
              <span class="ia-outline-pill">Help Centre</span>
              <span class="ia-outline-pill">Sign Out</span>
            </div>
          </div>
          <div class="ia-col">
            <span class="card-label">Supporting flows</span>
            <div class="ia-outline-row">
              <span class="ia-outline-pill">Login</span>
              <span class="ia-outline-pill">Registration</span>
              <span class="ia-outline-pill">Password recovery</span>
              <span class="ia-outline-pill">Checkout</span>
              <span class="ia-outline-pill">Delivery tracking</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE USER FLOWS -->
    <section class="flows" data-hk-reveal>
      <h2>Core user flows</h2>
      <div class="flows-col">
        <div class="flow-card">
          <span class="card-label card-label--muted">Core shopping flow</span>
          <div class="flow-chain">
            {shopFlow.map((n) => (
              <>
                <span class="flow-pill">{n}</span>
                <span class="flow-arrow">&rarr;</span>
              </>
            ))}
          </div>
        </div>
        <div class="repeat-flow-card">
          <div>
            <span class="card-label">Repeat-order flow &middot; Grovia&rsquo;s defining idea</span>
            <div class="flow-chain">
              {repeatFlow.map((n) => (
                <>
                  <span class="flow-pill flow-pill--accent">{n}</span>
                  <span class="flow-arrow flow-arrow--accent">&rarr;</span>
                </>
              ))}
            </div>
            <p class="repeat-quote">&ldquo;Yesterday&rsquo;s shopping list can become today&rsquo;s cart without rebuilding it item by item.&rdquo;</p>
          </div>
          <a href="/favorites-ms4nros4-7dfq.png" data-hk-lightbox>
            <img class="repeat-flow-img" src="/favorites-ms4nros4-7dfq.png" alt="Grovia shopping history screen" loading="lazy" />
          </a>
        </div>
      </div>
    </section>

    <!-- STARTING THE DESIGN -->
    <section class="start-design" data-hk-reveal>
      <h2>Starting the design</h2>
      <p class="lead-muted">Before adding colour and personality, I focused on structure, task order, and decision points.</p>
    </section>

    <!-- WIREFRAMES -->
    <section class="wireframes" data-hk-reveal>
      <div class="wf-intro">
        <h3>Structure before decoration</h3>
        <p class="sub">The first wireframes reduced the experience to its essential actions: finding products, building a cart, reusing a list, paying, and tracking an order.</p>
      </div>
      <div class="wf-grid">
        <div class="wf-item">
          <a href="/media/embedded/wf-home.webp" data-hk-lightbox>
            <div class="wf-frame"><img src="/media/embedded/wf-home.webp" alt="Wireframe of the Grovia home screen" loading="lazy" /></div>
          </a>
          <span class="wf-caption">Home</span>
        </div>
        <div class="wf-item">
          <a href="/media/embedded/wf-products.webp" data-hk-lightbox>
            <div class="wf-frame"><img src="/media/embedded/wf-products.webp" alt="Wireframe of the Grovia product listing screen" loading="lazy" /></div>
          </a>
          <span class="wf-caption">Product listing</span>
        </div>
        <div class="wf-item">
          <a href="/media/embedded/wf-history.webp" data-hk-lightbox>
            <div class="wf-frame"><img src="/media/embedded/wf-history.webp" alt="Wireframe of the Grovia shopping history screen" loading="lazy" /></div>
          </a>
          <span class="wf-caption">Shopping history</span>
        </div>
        <div class="wf-item">
          <a href="/media/embedded/wf-checkout.webp" data-hk-lightbox>
            <div class="wf-frame"><img src="/media/embedded/wf-checkout.webp" alt="Wireframe of the Grovia checkout screen" loading="lazy" /></div>
          </a>
          <span class="wf-caption">Checkout</span>
        </div>
      </div>
      <div class="wf-compare">
        <div class="compare-col">
          <a href="/media/embedded/wf-before.webp" data-hk-lightbox>
            <div class="compare-frame compare-frame--before"><img src="/media/embedded/wf-before.webp" alt="Early wireframe structure of the Grovia home screen" loading="lazy" /></div>
          </a>
          <span class="compare-tag">Early structure</span>
        </div>
        <div class="compare-col">
          <a href="/uploads/Home.png" data-hk-lightbox>
            <img class="compare-final-img" src="/uploads/Home.png" alt="Grovia final home screen" loading="lazy" />
          </a>
          <span class="compare-tag compare-tag--accent">Final interface</span>
        </div>
      </div>
    </section>

    <!-- LOW-FIDELITY PROTOTYPE -->
    <section class="lofi" data-hk-reveal>
      <div class="lofi-box">
        <div class="lofi-copy">
          <h3>Testing the journey before polishing the UI</h3>
          <p class="sub">The low-fidelity prototype connected the core screens into realistic tasks, allowing the flow to be evaluated before investing in detailed visual design.</p>
          <a href="#top" class="btn-outline">Open low-fi prototype<span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="lofi-tasks">
          {lofiTasks.map((t) => (
            <div class="lofi-task">
              <span class="lofi-num">{t.n}</span>
              <span class="lofi-label">{t.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- USABILITY STUDY -->
    <section class="usability" data-hk-reveal>
      <div class="usability-intro">
        <h2>Small moments of confusion revealed the biggest opportunities.</h2>
        <p class="sub">The low-fidelity prototype was tested through realistic grocery-shopping tasks. Observations and think-aloud feedback helped identify points of hesitation and unnecessary effort.</p>
      </div>
      <div class="findings-grid">
        {findings.map((f) => (
          <div class="finding-card">
            <span class="card-label">{f.tag}</span>
            <h3>{f.title}</h3>
            <p class="finding-quote">&ldquo;{f.quote}&rdquo;</p>
            <div class="finding-block">
              <span class="field-label">Insight</span>
              <p class="finding-muted">{f.insight}</p>
            </div>
            <div class="finding-block">
              <span class="field-label field-label--accent">Design response</span>
              <p class="finding-ink">{f.response}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- DESIGN EVOLUTION -->
    <section class="evolution" data-hk-reveal>
      <div class="evolution-intro">
        <h2>Feedback became visible design decisions</h2>
      </div>
      <div class="evolution-list">
        {evolution.map((e) => (
          <div class="evolution-row">
            <div class="evolution-before">
              <span class="field-label">Before</span>
              <span class="evolution-text">{e.before}</span>
            </div>
            <div class="evolution-after">
              <span class="field-label field-label--accent">After</span>
              <span class="evolution-text evolution-text--ink">{e.after}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- VISUAL DIRECTION -->
    <section class="visual" data-hk-reveal>
      <div class="visual-intro">
        <h2>Fresh, friendly, and familiar</h2>
        <p class="sub">The visual language combines natural greens with warm neutral surfaces. Rounded components and generous touch areas make the interface feel approachable, while stronger accent colours help prices and promotions stand out.</p>
      </div>
      <div class="visual-grid">
        <div class="visual-card">
          <div class="visual-block">
            <span class="field-label">Colour</span>
            <div class="swatch-row">
              <span class="swatch" style="background:#1B7A43"></span>
              <span class="swatch" style="background:#3DA35D"></span>
              <span class="swatch" style="background:#8BD24A"></span>
              <span class="swatch" style="background:#EFEBE2"></span>
              <span class="swatch" style="background:#C7264B"></span>
              <span class="swatch" style="background:#F6BE45"></span>
            </div>
          </div>
          <div class="visual-block">
            <span class="field-label">Buttons &amp; states</span>
            <div class="buttons-row">
              <span class="sample-btn">Add to Cart</span>
              <span class="sample-badge">Best Price</span>
              <img class="sample-icon" src="/uploads/Add%20Button.png" alt="Grovia add button" loading="lazy" />
            </div>
          </div>
          <div class="visual-block">
            <span class="field-label">Typography</span>
            <div class="type-sample">
              <span class="type-name">Nunito Sans &mdash; clear, rounded, friendly</span>
              <span class="type-desc">Used across the product interface for labels, prices and body.</span>
            </div>
          </div>
        </div>
        <div class="visual-cards-media">
          <a href="/uploads/Promo%20Product%20Card.png" data-hk-lightbox>
            <img class="visual-card-img" src="/uploads/Promo%20Product%20Card.png" alt="Grovia product card for bananas" loading="lazy" />
