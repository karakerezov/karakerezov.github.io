              <div class="ds-item"><span class="ds-item-label">Default</span><div class="ds-stage"><img src="/assets/grovia-design-system/button-primary-large.svg" width="252" height="104" alt="Primary button, default state" loading="lazy" /></div></div>
              <div class="ds-item"><span class="ds-item-label">Pressed</span><div class="ds-stage"><img src="/assets/grovia-design-system/button-primary-large-pressed.svg" width="196" height="48" alt="Primary button, pressed state" loading="lazy" /></div></div>
              <div class="ds-item"><span class="ds-item-label">Disabled</span><div class="ds-stage"><img src="/assets/grovia-design-system/button-primary-large-diabled.svg" width="196" height="48" alt="Primary button, disabled state" loading="lazy" /></div></div>
