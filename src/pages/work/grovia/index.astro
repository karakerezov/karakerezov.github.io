      </div>
      <div class="account-grid">
        <div class="account-col account-col--wide">
          <a href="/uploads/Login.png" data-hk-lightbox>
            <img class="account-img account-img--wide" src="/uploads/Login.png" alt="Grovia login screen" loading="lazy" />
          </a>
          <p class="account-caption">Consistent forms reduce learning between account-related tasks.</p>
        </div>
        <div class="account-col">
          <a href="/uploads/Registration.png" data-hk-lightbox>
            <img class="account-img" src="/uploads/Registration.png" alt="Grovia registration screen" loading="lazy" />
          </a>
          <a href="/uploads/Reset-Pass.png" data-hk-lightbox>
            <img class="account-img" src="/uploads/Reset-Pass.png" alt="Grovia reset password screen" loading="lazy" />
