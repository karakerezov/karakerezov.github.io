  .hk-shell { padding-top: 120px; }

  .eyebrow { font-size: 13px; font-weight: 600; line-height: 1; letter-spacing: 0.08em; text-transform: uppercase; color: var(--hk-accent); }
  .sub { font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }
  .lead-muted { font-size: 22px; line-height: 1.45; color: var(--hk-ink-2); text-wrap: pretty; margin: 0; }
  .card-label { font-size: 13px; font-weight: 600; line-height: 1; letter-spacing: 0.06em; text-transform: uppercase; color: var(--hk-accent); }
  .card-label--muted { color: var(--hk-ink-3-text); }
  .field-label { font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); text-transform: uppercase; letter-spacing: 0.06em; }
  .field-label--accent { color: var(--hk-accent); }
  .tag { font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-2); border: 1px solid var(--hk-hairline-2); background: var(--hk-pill-fill); border-radius: var(--hk-r-pill); padding: 10px 18px; }
  .note { font-size: 13px; font-weight: 600; line-height: 1.4; color: var(--hk-ink-3-text); margin-top: 8px; }

  section > h2 { font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2); line-height: 1.05; letter-spacing: -0.02em; margin: 0; }

  /* Buttons */
  .btn-primary { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-bg); background: var(--hk-accent); border: 1px solid var(--hk-accent); border-radius: var(--hk-r-pill); padding: 16px 28px; transition: background .25s ease, border-color .25s ease; }
  .btn-primary:hover { background: #007C88; border-color: #007C88; color: var(--hk-bg); }
  .btn-ghost { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink); }
  .btn-outline { display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink); background: transparent; border: 1px solid var(--hk-hairline-3); border-radius: var(--hk-r-pill); padding: 14px 24px; transition: background .25s ease; }
  .btn-outline:hover { background: var(--hk-hover-tint); color: var(--hk-ink); }
  .cta-row { margin-top: 36px; display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .cta-row--center { margin-top: 0; justify-content: center; gap: 24px; }
  .cta-row--center .btn-outline { align-self: center; }

  /* HERO */
  .hero-visual { padding: 0 0 72px; }
  .media-cover { border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface-alt); border: 1px solid var(--hk-hairline); }
  .media-cover img { width: 100%; height: auto; display: block; }

  .hero { padding: 0 0 112px; display: flex; flex-direction: column; }
  .hero-heading h1 { font-family: var(--hk-font-display); font-weight: 400; font-size: clamp(56px, 6vw, 96px); line-height: 0.95; letter-spacing: -0.03em; margin: 24px 0 0; }
  .hero-intro-grid { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .hero-intro-left .lead { margin: 0; font-size: 22px; line-height: 1.45; color: var(--hk-ink); font-weight: 600; }
  .hero-intro-left .sub { margin: 20px 0 0; }
  .meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px 32px; }
  .meta-item { display: flex; flex-direction: column; gap: 6px; }
  .meta-label { font-size: 13px; font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); text-transform: uppercase; letter-spacing: 0.06em; }
  .meta-value { font-size: 15px; font-weight: 600; color: var(--hk-ink); }

  /* STORY */
  .story { padding: 64px 0 128px; display: flex; justify-content: center; }
  .story-inner { max-width: 760px; display: flex; flex-direction: column; gap: 32px; }
  .story h2 { font-family: var(--hk-font-display); font-weight: 400; font-size: clamp(36px, 4vw, 52px); line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; }
  .story-quote { margin: 0; background: var(--hk-accent-soft); border-radius: var(--hk-r-media); padding: 48px; }
  .story-quote p { margin: 0; font-family: var(--hk-font-display); font-size: 32px; line-height: 1.2; letter-spacing: -0.01em; color: var(--hk-ink); }

  /* OVERVIEW */
  .overview { padding: 0 0 128px; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .overview-copy { display: flex; flex-direction: column; gap: 24px; }
  .overview-cards { display: flex; flex-direction: column; gap: 16px; }
  .overview-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card-sm); padding: 28px 32px; display: flex; flex-direction: column; gap: 8px; }
  .overview-card p { margin: 0; font-size: 17px; line-height: 1.5; color: var(--hk-ink); }

  /* CHALLENGE */
  .challenge { padding: 0 0 128px; }
  .challenge-intro { max-width: 760px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 56px; }
  .challenge-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .challenge-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-media); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .challenge-num { font-family: var(--hk-font-display); font-size: 24px; line-height: 1; color: var(--hk-accent); }
  .challenge-card h3 { margin: 0; font-size: 18px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; }
  .challenge-card p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--hk-ink-2); }

  /* RESEARCH */
  .research { padding: 64px 0 128px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; }
  .research-copy { display: flex; flex-direction: column; gap: 24px; }
  .research-copy h2 { font-family: var(--hk-font-display); font-weight: 400; font-size: clamp(44px, 4.6vw, 64px); line-height: 1; letter-spacing: -0.02em; margin: 0; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .research-media { border-radius: var(--hk-r-card); overflow: hidden; background: var(--hk-surface-alt); border: 1px solid var(--hk-hairline); height: 480px; position: relative; }
  .research-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* INSIGHTS */
  .insights { padding: 0 0 128px; }
  .insights > h2 { margin: 0 0 56px; }
  .insights-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .insight-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-media); padding: 40px; display: flex; flex-direction: column; gap: 12px; }
  .insight-card h3 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .insight-card p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--hk-ink-2); }

  /* PERSONA */
  .persona { padding: 0 0 128px; }
  .persona-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card); padding: 24px; display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: stretch; }
  .persona-media { border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface-alt); position: relative; min-height: 440px; }
  .persona-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .persona-info { display: flex; flex-direction: column; gap: 24px; padding: 24px 32px 24px 8px; }
  .persona-head { display: flex; flex-direction: column; gap: 6px; }
  .persona-head h3 { margin: 6px 0 0; font-family: var(--hk-font-display); font-weight: 400; font-size: 40px; line-height: 1; letter-spacing: -0.02em; }
  .persona-sub { font-size: 15px; color: var(--hk-ink-2); }
  .persona-quote { margin: 0; border-left: 2px solid var(--hk-accent); padding-left: 20px; }
  .persona-quote p { margin: 0; font-family: var(--hk-font-display); font-size: 24px; line-height: 1.25; color: var(--hk-ink); }
  .persona-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .persona-field { display: flex; flex-direction: column; gap: 8px; }
  .persona-field p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--hk-ink); }

  /* JOURNEY */
  .journey { padding: 0 0 128px; }
  .journey-intro { max-width: 760px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 48px; }
  .journey-scroll { overflow-x: auto; padding-bottom: 8px; }
  .journey-grid { display: grid; grid-template-columns: repeat(6, minmax(190px, 1fr)); gap: 16px; min-width: 760px; }
  .journey-col { display: flex; flex-direction: column; gap: 14px; }
  .journey-stage-row { display: flex; align-items: center; gap: 10px; }
  .journey-dot { width: 10px; height: 10px; border-radius: var(--hk-r-pill); flex-shrink: 0; }
  .journey-stage { font-size: 15px; font-weight: 700; line-height: 1; color: var(--hk-ink); }
  .journey-divider { height: 1px; background: rgba(21,21,21,0.10); }
  .journey-card { display: flex; flex-direction: column; gap: 10px; background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card-sm); padding: 20px; }
  .journey-label { font-size: 13px; font-weight: 600; color: var(--hk-ink-3-text); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 6px; }
  .journey-label--accent { color: var(--hk-accent); }
  .journey-text { font-size: 14px; line-height: 1.45; color: var(--hk-ink-2); }
  .journey-text--ink { color: var(--hk-ink); }
  .journey-thought { font-size: 14px; line-height: 1.45; color: var(--hk-ink-2); font-style: italic; }
  .journey-emotion { font-size: 13px; font-weight: 600; text-align: center; }

  /* PROBLEM */
  .problem { padding: 32px 0 128px; }
  .problem-box { background: var(--hk-surface-alt); border-radius: var(--hk-r-card); padding: 96px 64px; display: flex; flex-direction: column; gap: 40px; align-items: center; text-align: center; }
  .problem-text { margin: 0; max-width: 900px; font-size: 24px; line-height: 1.5; color: var(--hk-ink); text-wrap: pretty; }
  .problem-text .highlight { color: var(--hk-accent); font-weight: 700; }
  .problem-h2 { margin: 0; max-width: 840px; font-family: var(--hk-font-display); font-weight: 400; font-size: clamp(36px, 4.4vw, 56px); line-height: 1.08; letter-spacing: -0.02em; }

  /* PRINCIPLES */
  .principles { padding: 0 0 128px; }
  .principles > h2 { margin: 0 0 56px; }
  .principles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .principle-col { display: flex; flex-direction: column; gap: 24px; }
  .principle-col > a { display: block; }
  .principle-img { display: block; width: 70%; margin: 0 auto; height: auto; filter: drop-shadow(0 22px 38px rgba(21,21,21,0.12)); }
  .principle-text { display: flex; flex-direction: column; gap: 10px; }
  .principle-text h3 { margin: 0; font-size: 24px; font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; }
  .principle-text p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--hk-ink-2); }

  /* IA */
  .ia { padding: 0 0 128px; }
  .ia-intro { max-width: 760px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 56px; }
  .ia-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card); padding: 56px 48px; display: flex; flex-direction: column; gap: 40px; align-items: center; }
  .ia-badge { font-size: 15px; font-weight: 700; line-height: 1; color: var(--hk-bg); background: var(--hk-accent); border-radius: var(--hk-r-pill); padding: 14px 28px; }
  .ia-divider { width: 1px; height: 24px; background: rgba(0,144,158,0.4); }
  .ia-nav-block { width: 100%; display: flex; flex-direction: column; gap: 12px; align-items: center; }
  .ia-pill-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .ia-pill { font-size: 15px; font-weight: 600; color: var(--hk-ink); background: var(--hk-surface-alt); border-radius: var(--hk-r-pill); padding: 12px 24px; }
  .ia-split { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; border-top: 1px solid var(--hk-hairline); padding-top: 40px; }
  .ia-col { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .ia-outline-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .ia-outline-pill { font-size: 14px; font-weight: 600; color: var(--hk-ink-2); border: 1px solid var(--hk-hairline-2); border-radius: var(--hk-r-pill); padding: 9px 16px; }

  /* FLOWS */
  .flows { padding: 0 0 128px; }
  .flows > h2 { margin: 0 0 40px; }
  .flows-col { display: flex; flex-direction: column; gap: 32px; }
  .flow-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-media); padding: 40px; }
  .flow-chain { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .flow-pill { font-size: 14px; font-weight: 600; color: var(--hk-ink); background: var(--hk-surface-alt); border-radius: var(--hk-r-pill); padding: 11px 18px; }
  .flow-pill--accent { color: var(--hk-accent); background: rgba(0,144,158,0.10); }
  .flow-arrow { color: var(--hk-ink-3-text); font-size: 14px; }
  .flow-arrow--accent { color: var(--hk-accent); }
  .repeat-flow-card { border: 1px solid rgba(0,144,158,0.24); border-radius: var(--hk-r-media); padding: 40px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; background-color: var(--hk-surface); }
  .repeat-quote { margin: 28px 0 0; font-family: var(--hk-font-display); font-size: 26px; line-height: 1.25; color: var(--hk-ink); max-width: 520px; }
  .repeat-flow-card > a { display: block; }
  .repeat-flow-img { display: block; width: 62%; margin: 0 auto; height: auto; filter: drop-shadow(0 22px 38px rgba(21,21,21,0.12)); }

  /* START DESIGN */
  .start-design { padding: 64px 0 96px; display: flex; flex-direction: column; gap: 24px; max-width: 820px; }
  .start-design h2 { font-family: var(--hk-font-display); font-weight: 400; font-size: clamp(44px, 4.6vw, 64px); line-height: 1; letter-spacing: -0.02em; }

  /* WIREFRAMES */
  .wireframes { padding: 0 0 96px; }
  .wf-intro { max-width: 760px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 48px; }
  .wf-intro h3 { font-family: var(--hk-font-display); font-weight: 400; font-size: 40px; line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
  .wf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 56px; }
  .wf-item { display: flex; flex-direction: column; gap: 12px; }
  .wf-item > a { display: block; }
  .wf-frame { border-radius: var(--hk-r-card-sm); overflow: hidden; background: var(--hk-surface-alt); aspect-ratio: 816 / 1662; position: relative; border: 3px solid #898989; }
  .wf-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wf-caption { font-size: 13px; font-weight: 600; color: var(--hk-ink-3-text); text-align: center; }
  .wf-compare { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card); padding: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .compare-col { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .compare-col > a { display: flex; align-items: center; justify-content: center; width: 100%; flex: 1; }
  .compare-frame { border-radius: var(--hk-r-card-sm); overflow: hidden; background: var(--hk-surface-alt); aspect-ratio: 816 / 1662; width: 56%; position: relative; border: 2px solid #DBDBDB; }
  .compare-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .compare-final-img { display: block; width: 56%; height: auto; filter: drop-shadow(0 22px 38px rgba(21,21,21,0.12)); }
  .compare-tag { font-size: 13px; font-weight: 600; color: var(--hk-ink-3-text); border: 1px solid var(--hk-hairline-2); border-radius: var(--hk-r-pill); padding: 8px 16px; }
  .compare-tag--accent { color: var(--hk-accent); background: rgba(0,144,158,0.10); border-color: transparent; }

  /* LOFI */
  .lofi { padding: 32px 0 128px; }
  .lofi-box { background: var(--hk-surface-alt); border-radius: var(--hk-r-card); padding: 64px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .lofi-copy { display: flex; flex-direction: column; gap: 20px; }
  .lofi-copy h3 { font-family: var(--hk-font-display); font-weight: 400; font-size: 40px; line-height: 1.08; letter-spacing: -0.02em; margin: 0; }
  .lofi-tasks { display: flex; flex-direction: column; gap: 12px; }
  .lofi-task { display: flex; align-items: center; gap: 14px; background: var(--hk-surface); border-radius: 20px; padding: 16px 22px; }
  .lofi-num { width: 26px; height: 26px; border-radius: var(--hk-r-pill); background: rgba(0,144,158,0.10); color: var(--hk-accent); font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .lofi-label { font-size: 16px; font-weight: 600; color: var(--hk-ink); }

  /* USABILITY */
  .usability { padding: 0 0 128px; }
  .usability-intro { max-width: 820px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 56px; }
  .usability-intro h2 { font-family: var(--hk-font-display); font-weight: 400; font-size: clamp(36px, 4vw, 52px); line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance; }
  .findings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .finding-card { background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-media); padding: 40px; display: flex; flex-direction: column; gap: 16px; }
  .finding-card h3 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .finding-quote { margin: 0; font-family: var(--hk-font-display); font-size: 22px; line-height: 1.3; color: var(--hk-ink); }
  .finding-block { display: flex; flex-direction: column; gap: 4px; }
  .finding-muted { margin: 0; font-size: 15px; line-height: 1.5; color: var(--hk-ink-2); }
  .finding-ink { margin: 0; font-size: 15px; line-height: 1.5; color: var(--hk-ink); }

  /* EVOLUTION */
  .evolution { padding: 0 0 128px; }
  .evolution-intro { max-width: 760px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 56px; }
  .evolution-list { display: flex; flex-direction: column; gap: 20px; }
  .evolution-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .evolution-before { background: var(--hk-surface-alt); border-radius: var(--hk-r-card-sm); padding: 28px 32px; display: flex; flex-direction: column; gap: 8px; }
  .evolution-after { background: var(--hk-surface); border: 1px solid rgba(0,144,158,0.24); border-radius: var(--hk-r-card-sm); padding: 28px 32px; display: flex; flex-direction: column; gap: 8px; }
  .evolution-text { font-size: 16px; line-height: 1.5; color: var(--hk-ink-2); }
  .evolution-text--ink { color: var(--hk-ink); }

  /* VISUAL */
  .visual { padding: 0 0 128px; }
  .visual-intro { max-width: 760px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 56px; }
  .visual-card-img { width: 100%; height: auto; display: block; filter: drop-shadow(0 18px 30px rgba(21,21,21,0.10)); }

  /* Design system showcase — values from the Grovia Figma file (01 Style Tokens, 06 Sizing tokens, text styles) */
  .ds {
    --g-surface: #F5F3F0;      /* Neutral/Surface/Default = Warm-Grey/100 */
    --g-title: #393733;        /* Neutral/Text/Title = Warm-Grey/800 */
    --g-body: #716D65;         /* Neutral/Text/Body = Warm-Grey/600 */
    --g-border: #E9E5DE;       /* Warm-Grey/200 */
    --g-green: #00A651;        /* Green/600 */
    --g-gradient: linear-gradient(90deg, #00A651 54.8077%, #ADFB44 99.5192%);
  }
  .ds-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch; }
  .ds-panel {
    background: var(--g-surface); border: 1px solid var(--g-border); border-radius: var(--hk-r-media);
    padding: 40px; display: flex; flex-direction: column; gap: 36px; min-width: 0;
    font-family: 'Urbanist', 'Nunito Sans', sans-serif; color: var(--g-title);
  }
  .ds-title { font-family: 'Urbanist', 'Nunito Sans', sans-serif; font-size: 25px; line-height: 30px; font-weight: 700; color: var(--g-title); margin: 0; }
  .ds-block { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .ds-label { font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--g-body); }
  .ds-meta { margin: 0; font-size: 14px; line-height: 18px; font-weight: 500; color: var(--g-body); }
  .ds i { font-style: normal; }
  .ds-panel ul { list-style: none; margin: 0; padding: 0; }

  .ds-swatches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 12px; }
  .ds-swatches li { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ds-chip { display: block; height: 48px; border-radius: 16px; }
  .ds-chip--line { box-shadow: inset 0 0 0 1px rgba(57,55,51,0.12); }
  .ds-swatches b, .ds-semantic b { font-size: 14px; line-height: 18px; font-weight: 600; color: var(--g-title); overflow-wrap: anywhere; }
  .ds-swatches i, .ds-semantic i { font-size: 12px; line-height: 16px; font-weight: 500; color: var(--g-body); }

  .ds-gradient { height: 48px; border-radius: 999px; background: var(--g-gradient); }

