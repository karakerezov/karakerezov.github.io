---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
---

<BaseLayout
  title="Recent Work | Hristo Karakerezov"
  description="A few recent projects across apps, websites and digital interfaces — Grovia, Display Daily, Elfy Tours and more — designed by Hristo Karakerezov."
  active="work"
>
  <div class="hk-shell">

    <section class="intro">
      <h1>Recent Work</h1>
      <p class="lead">A few recent projects across apps, websites and digital interfaces that I enjoyed working on.</p>
    </section>

    <section class="project-grid">

      <article class="card" data-hk-reveal>
        <div class="card-media">
          <div class="card-media-zoom">
            <a href="/work/grovia/" aria-label="Grovia case study" class="media-link">
              <img src="/assets/grovia-hero.png" alt="Grovia — grocery app mockups" />
            </a>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3>Grovia</h3>
            <span class="card-kicker">Grocery Mobile App</span>
          </div>
          <p class="card-desc">A mobile app concept for easier grocery shopping, simple product discovery and clear everyday use.</p>
          <div class="tag-row">
            <span class="tag">UX/UI Design</span>
            <span class="tag">Mobile App</span>
            <span class="tag">Product Design</span>
          </div>
          <div class="card-cta">
            <a class="btn-pill-dark" href="/work/grovia/">View Case Study<span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </article>

      <article class="card card-protected" data-hk-reveal>
        <div class="card-media well-dark">
          <div class="well-blur"></div>
          <div class="well-veil">
            <div class="protected-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#151515" stroke-width="2" stroke-linecap="round"><rect x="4" y="11" width="16" height="10" rx="3"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
              <span>Protected</span>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3>Touchscreen Design for Generic Soft</h3>
            <span class="card-kicker">Touchscreen Interface System</span>
          </div>
          <p class="card-desc">A touchscreen interface project for a connected device system. The details are protected due to NDA.</p>
          <div class="tag-row">
            <span class="tag">Interface Design</span>
            <span class="tag">Touchscreen UI</span>
            <span class="tag">NDA Project</span>
          </div>
          <div class="limited-row">
            <a class="limited-link" href="#top">Limited Access<span aria-hidden="true">&rarr;</span></a>
            <span class="limited-note">Protected case study — available with password.</span>
          </div>
        </div>
      </article>

      <article class="card" data-hk-reveal>
        <div class="card-media">
          <div class="card-media-zoom">
            <a href="/work/display-daily/" aria-label="Display Daily case study" class="media-link">
              <img src="/assets/display-daily-hero.png" alt="Display Daily — responsive publishing platform mockups" loading="lazy" />
            </a>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3>Display Daily</h3>
            <span class="card-kicker">Digital Publishing Platform</span>
          </div>
          <p class="card-desc">A web platform for browsing, subscribing to and reading digital versions of printed newspapers and magazines.</p>
          <div class="tag-row">
            <span class="tag">UX/UI Design</span>
            <span class="tag">Web Platform</span>
            <span class="tag">Subscription Flow</span>
          </div>
          <div class="card-cta">
            <a class="btn-pill-dark" href="/work/display-daily/">View Case Study<span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </article>

      <article class="card" data-hk-reveal>
        <div class="card-media">
          <div class="card-media-zoom">
            <a href="/work/elfy-tours/" aria-label="Elfy Tours case study" class="media-link">
              <img src="/media/drive/1ywcPTPjkUlWHL0sIWqMsaHNzboF-AgFo.png" alt="Elfy Tours — web and mobile travel interface" />
            </a>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3>Elfy Tours</h3>
            <span class="card-kicker">Travel Website</span>
          </div>
          <p class="card-desc">A responsive website for a travel brand, focused on clear content, visual atmosphere and easy navigation.</p>
          <div class="tag-row">
            <span class="tag">Web Design</span>
            <span class="tag">UX/UI Design</span>
            <span class="tag">Responsive Website</span>
          </div>
          <div class="card-cta">
            <a class="btn-pill-dark" href="/work/elfy-tours/">View Case Study<span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </article>

    </section>

    <section class="archive-transition" data-hk-reveal>
      <div class="transition-card">
        <div class="transition-copy">
          <h2>Earlier visual work</h2>
          <p>Before UX/UI became the main focus, years of work in branding, packaging and print design shaped the visual side of the practice.</p>
        </div>
        <a class="btn-pill-outline" href="/archive/">Explore Archive<span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <section id="contact" class="contact-section" data-hk-reveal>
      <ContactCTA layout="row-dual" showCopyright={true} />
    </section>

  </div>
</BaseLayout>

<style>
  .intro { padding: 200px 0 96px; }
  .intro h1 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h1-page);
    line-height: 1; letter-spacing: -0.03em; margin: 0;
  }
  .intro .lead { margin: 32px 0 0; font-size: var(--hk-lead); line-height: 1.45; color: var(--hk-ink-2); max-width: 680px; text-wrap: pretty; }

  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--hk-gap); padding-bottom: 96px; }

  .card {
    background: var(--hk-surface); border: 1px solid var(--hk-hairline); border-radius: var(--hk-r-card);
    padding: 24px; display: flex; flex-direction: column; gap: 22px; transition: var(--hk-t-card);
  }
  .card:hover { transform: var(--hk-lift); box-shadow: var(--hk-card-shadow); }

  .card-media { border-radius: var(--hk-r-media); overflow: hidden; background: var(--hk-surface-alt); height: 340px; position: relative; }
  .card-media-zoom { position: absolute; inset: 0; transition: var(--hk-t-media); }
  .card:hover .card-media-zoom { transform: var(--hk-zoom); }
  .media-link { position: absolute; inset: 0; display: block; }
  .media-link img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }

  .card-body { display: flex; flex-direction: column; gap: 14px; padding: 8px 12px 12px; }
  .card-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .card-title-row h3 { margin: 0; font-size: var(--hk-h3); font-weight: 700; line-height: 1.15; letter-spacing: -0.015em; }
  .card-kicker { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); }
  .card-desc { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }

  .tag-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-2);
    border: 1px solid var(--hk-hairline-2); background: var(--hk-pill-fill); border-radius: var(--hk-r-pill); padding: 8px 14px;
  }

  .card-cta { margin-top: 8px; }
  .btn-pill-dark {
    display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1;
    color: var(--hk-bg); background: var(--hk-ink); border: 1px solid var(--hk-ink); border-radius: var(--hk-r-pill);
    padding: 14px 24px; transition: background .25s ease, border-color .25s ease;
  }
  .btn-pill-dark:hover { background: var(--hk-accent); border-color: var(--hk-accent); color: var(--hk-bg); }

  .btn-pill-outline {
    display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1;
    color: var(--hk-ink); background: transparent; border: 1px solid var(--hk-hairline-3); border-radius: var(--hk-r-pill);
    padding: 14px 24px; transition: background .25s ease; flex-shrink: 0;
  }
  .btn-pill-outline:hover { background: var(--hk-hover-tint); color: var(--hk-ink); }

  .well-dark { background: var(--hk-dark-well); }
  .well-blur { position: absolute; inset: 0; filter: blur(3px) brightness(0.55); transform: scale(1.04); background: var(--hk-dark-well); }
  .well-veil {
    position: absolute; inset: 0; backdrop-filter: blur(2px); background: var(--hk-veil);
    display: flex; align-items: center; justify-content: center; pointer-events: none;
  }
  .protected-pill {
    display: flex; align-items: center; gap: 10px; background: var(--hk-badge); border-radius: var(--hk-r-pill);
    padding: 12px 20px; color: var(--hk-ink);
  }
  .protected-pill span { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; }

  .limited-row { margin-top: 8px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .limited-link { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; line-height: 1; color: var(--hk-ink); }
  .limited-note { font-size: var(--hk-meta-sm); font-weight: 600; line-height: 1; color: var(--hk-ink-3-text); }

  .archive-transition { padding: 32px 0 96px; }
  .transition-card {
    background: var(--hk-surface-alt); border-radius: var(--hk-r-card); padding: 72px 64px;
    display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap;
  }
  .transition-copy { max-width: 680px; display: flex; flex-direction: column; gap: 20px; }
  .transition-copy h2 {
    font-family: var(--hk-font-display); font-weight: 400; font-size: var(--hk-h2);
    line-height: 1.05; letter-spacing: -0.02em; margin: 0;
  }
  .transition-copy p { margin: 0; font-size: var(--hk-body); line-height: 1.55; color: var(--hk-ink-2); text-wrap: pretty; }

  .contact-section { padding: 0 0 96px; }

  @media (max-width: 900px) {
    .project-grid { grid-template-columns: 1fr; }
    .transition-card { padding: 48px 32px; }
  }
</style>
